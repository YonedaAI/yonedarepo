{
  "name": "yoneda-test",
  "main": "entrypoint.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "OWNER_TOKEN": "local-test-owner"
  },
  "services": [
    {
      "binding": "SELF",
      "service": "yoneda-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceAuthority"
      },
      {
        "name": "SOURCE_REPOS",
        "class_name": "SourceRepository"
      },
      {
        "name": "COMMIT_SHARDS",
        "class_name": "CommitShard"
      },
      {
        "name": "LAND_COMBINERS",
        "class_name": "LandCombiner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorkspaceAuthority",
        "SourceRepository",
        "CommitShard",
        "LandCombiner"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "yoneda-local-test"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yoneda-platform-test"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "yoneda-test-index",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
