{
  "name": "yoneda-test",
  "main": "entrypoint.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "OWNER_TOKEN": "local-test-owner",
    "ARTIFACTS_NAMESPACE": "yoneda-test",
    "CODEX_MODEL": "gpt-5.6-luna",
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "PLATFORM_OBJECT_STORE": "r2",
    "VAULT_KEY": "1111111111111111111111111111111111111111111111111111111111111111"
  },
  "services": [
    {
      "binding": "SELF",
      "service": "yoneda-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORIES",
        "class_name": "RepositoryAuthority"
      },
      {
        "name": "LIVE",
        "class_name": "LiveRoom"
      },
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceAuthority"
      },
      {
        "name": "SOURCES",
        "class_name": "SourceWorkspaceAuthority"
      },
      {
        "name": "SOURCE_REPOS",
        "class_name": "SourceRepository"
      },
      {
        "name": "OBJECT_PUSHES",
        "class_name": "ObjectPushQueue"
      },
      {
        "name": "COMMIT_SHARDS",
        "class_name": "CommitShard"
      },
      {
        "name": "LAND_COMBINERS",
        "class_name": "LandCombiner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RepositoryAuthority",
        "LiveRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "WorkspaceAuthority"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "SourceWorkspaceAuthority"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "SourceRepository"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "ObjectPushQueue"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "CommitShard"
      ]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": [
        "LandCombiner"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "yoneda-local-test"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yoneda-platform-test"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "yoneda-test-index",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
