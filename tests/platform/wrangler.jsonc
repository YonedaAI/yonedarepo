{
  "name": "yoneda-platform-test",
  "main": "entrypoint.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ARTIFACTS_NAMESPACE": "yoneda-test", "OWNER_TOKEN": "local-test-owner", "VAULT_KEY": "1111111111111111111111111111111111111111111111111111111111111111" },
  "services": [{ "binding": "SELF", "service": "yoneda-platform-test" }],
  "durable_objects": {
    "bindings": [
      { "name": "SOURCE_REPOS", "class_name": "SourceRepository" },
      { "name": "WORKSPACES", "class_name": "WorkspaceAuthority" },
      { "name": "OBJECT_PUSHES", "class_name": "ObjectPushQueue" },
      { "name": "COMMIT_SHARDS", "class_name": "CommitShard" },
      { "name": "LAND_COMBINERS", "class_name": "LandCombiner" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SourceRepository", "WorkspaceAuthority"] },
    { "tag": "v2", "new_sqlite_classes": ["ObjectPushQueue"] },
    { "tag": "v3", "new_sqlite_classes": ["CommitShard"] },
    { "tag": "v4", "new_sqlite_classes": ["LandCombiner"] }
  ],
  "queues": { "producers": [{ "binding": "PLATFORM_QUEUE", "queue": "yoneda-platform-test" }] },
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "yoneda-platform-test" }],
  "d1_databases": [{ "binding": "INDEX", "database_name": "yoneda-platform-index", "database_id": "00000000-0000-0000-0000-000000000001" }]
}
