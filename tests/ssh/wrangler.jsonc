// The platform Worker alone for the local SSH end-to-end test (tests/ssh/e2e.mjs): served by
// `wrangler dev`, with objects in local R2 and a fixed local-only gateway secret. Nothing here
// is deployed.
{
  "name": "yoneda-ssh-e2e",
  "main": "../platform/entrypoint.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ARTIFACTS_NAMESPACE": "yoneda-ssh-e2e",
    "PLATFORM_OBJECT_STORE": "r2",
    "SSH_GATEWAY_SECRET": "local-ssh-e2e-gateway-secret-0123456789"
  },
  "services": [{ "binding": "SELF", "service": "yoneda-ssh-e2e" }],
  "durable_objects": {
    "bindings": [
      { "name": "SOURCE_REPOS", "class_name": "SourceRepository" },
      { "name": "WORKSPACES", "class_name": "WorkspaceAuthority" },
      { "name": "OBJECT_PUSHES", "class_name": "ObjectPushQueue" },
      { "name": "COMMIT_SHARDS", "class_name": "CommitShard" },
      { "name": "LAND_COMBINERS", "class_name": "LandCombiner" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SourceRepository", "WorkspaceAuthority", "ObjectPushQueue", "CommitShard", "LandCombiner"] }
  ],
  "queues": { "producers": [{ "binding": "PLATFORM_QUEUE", "queue": "yoneda-ssh-e2e" }] },
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "yoneda-ssh-e2e" }],
  "d1_databases": [
    { "binding": "INDEX", "database_name": "yoneda-ssh-e2e-index", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "../../cloudflare/migrations" }
  ]
}
