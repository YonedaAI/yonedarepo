// The eval Worker's tests: its spend ledger Durable Object next to a platform-only Worker
// (the eval Worker reaches the platform through its public API, here in-process).
{
  "name": "yoneda-eval-test",
  "main": "entrypoint.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ARTIFACTS_NAMESPACE": "yoneda-test", "VAULT_KEY": "1111111111111111111111111111111111111111111111111111111111111111", "EVAL_SPEND_CAP_MICROUSD": "8000" },
  "services": [{ "binding": "SELF", "service": "yoneda-eval-test" }],
  "durable_objects": {
    "bindings": [
      { "name": "SOURCE_REPOS", "class_name": "SourceRepository" },
      { "name": "WORKSPACES", "class_name": "WorkspaceAuthority" },
      { "name": "OBJECT_PUSHES", "class_name": "ObjectPushQueue" },
      { "name": "SPEND", "class_name": "SpendLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SourceRepository", "WorkspaceAuthority"] },
    { "tag": "v2", "new_sqlite_classes": ["ObjectPushQueue"] },
    { "tag": "v3", "new_sqlite_classes": ["SpendLedger"] }
  ],
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "yoneda-platform-test" }],
  "d1_databases": [{ "binding": "INDEX", "database_name": "yoneda-platform-index", "database_id": "00000000-0000-0000-0000-000000000001" }]
}
