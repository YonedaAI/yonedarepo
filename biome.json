{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "cloudflare/worker/**",
      "cloudflare/eval/**",
      "cloudflare/superfan/**",
      "cloudflare/managed/**",
      "frontend/src/**",
      "shared/**",
      "!shared/contracts/**",
      "!**/wasm.d.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": false
    }
  }
}
