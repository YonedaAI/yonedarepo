// Platform-only Worker: the source platform with the agent layer switched off. Its stores
// (Artifacts namespace, R2, D1, queues) are its own, so it never shares state with the
// production yonedarepo-dev Worker.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yonedarepo-platform-dev",
  "main": "worker/platform-index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Run next to the data: a commit makes about ten round trips to its repository's
  // Durable Object, R2 (ENAM) and Artifacts, so each costs a hop to the client's colo
  // otherwise. New repository objects are created near the placed Worker.
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  // The superfan watcher (wrangler.superfan.jsonc) receives this Worker's tail events:
  // outcomes, logs, exceptions and CPU/wall time, with no API token.
  "tail_consumers": [
    {
      "service": "yonedarepo-superfan-dev"
    }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ARTIFACTS_NAMESPACE": "yoneda-platform-dev"
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "yoneda-platform-dev",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceAuthority"
      },
      {
        "name": "SOURCE_REPOS",
        "class_name": "SourceRepository"
      },
      {
        "name": "CHECK_RUNNERS",
        "class_name": "CheckContainer"
      },
      {
        "name": "OBJECT_PUSHES",
        "class_name": "ObjectPushQueue"
      },
      {
        "name": "COMMIT_SHARDS",
        "class_name": "CommitShard"
      },
      {
        "name": "LAND_COMBINERS",
        "class_name": "LandCombiner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SourceRepository",
        "WorkspaceAuthority",
        "CheckContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ObjectPushQueue"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "CommitShard"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "LandCombiner"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "CheckContainer",
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "max_instances": 8,
      "instance_type": "standard-1",
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "yonedarepo-platform-dev-objects"
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "yonedarepo-platform-dev-index",
      "database_id": "1fdff638-62c5-4c56-b01b-1480877ed239",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yonedarepo-platform-dev-jobs"
      },
      {
        "binding": "PLATFORM_CHECKS",
        "queue": "yonedarepo-platform-dev-checks"
      }
    ],
    "consumers": [
      {
        "queue": "yonedarepo-platform-dev-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_concurrency": 20,
        "max_retries": 3,
        "dead_letter_queue": "yonedarepo-platform-dev-dead-letter"
      },
      // Check runs take minutes (container start, the check): one per invocation, up to
      // the container limit at once, apart from the derive and projection jobs above.
      {
        "queue": "yonedarepo-platform-dev-checks",
        "max_batch_size": 1,
        "max_concurrency": 8,
        "max_retries": 3,
        "dead_letter_queue": "yonedarepo-platform-dev-dead-letter"
      }
    ]
  },
  // Change-log analytics (P4): stream yonedarepo_platform_dev_changes_v1, schema in
  // basin/change-log.schema.json, sunk to an Iceberg table in the Basin Catalog on the
  // yonedarepo-platform-dev-analytics bucket.
  "pipelines": [
    {
      "binding": "CHANGELOG",
      "stream": "e855956706484e489eeb0dfa41a383d2"
    }
  ],
  "workflows": [
    {
      "name": "yonedarepo-platform-dev-import",
      "binding": "PLATFORM_IMPORT",
      "class_name": "PlatformImportWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "services": [
    {
      "binding": "SELF",
      "service": "yonedarepo-platform-dev"
    }
  ]
}
