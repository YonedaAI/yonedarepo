// Generated from infra/envs/dev.json by `cargo xtask infra up`; edit the spec, not this file.
// Dev managed agents Worker (cloudflare/managed): YonedaRepo's maintained reviewers (code, security,
// slop review), run as an ordinary API client of the platform. A workspace owner enables an agent
// from the browser (front Worker /api/managed -> MANAGED service binding); the owner's own session
// mints each chosen repository's token (yoneda-managed-agents: read, review, check) and webhook
// (change, branch) to https://managed.dev.yonedarepo.com/hooks/<repo>. That hostname serves only signed webhooks and
// /health. Runs are queued (RUNS, at least once) and run as one Workflow instance per run (REVIEWS):
// a HarnessContainer (cloudflare/containers/harness: Claude Code, Codex, opencode, pinned) with no
// internet clones the change lazily and runs the agent's CLI; its only ways out are the Worker's
// outbound handlers (platform reads with the token added, AI Gateway with the key added, metered
// per request). The Worker posts anchored comments, a summary and the agent's check.
// Model calls go through AI Gateway {prefix}-managed-agents (AI_GATEWAY_URL; slugs in
// AI_GATEWAY_PROVIDERS: anthropic and openai built in; custom-zai and custom-mimo are custom
// providers with base URLs https://api.z.ai and https://api.xiaomimimo.com). Keys: Secrets Store
// secrets Claude, Codex, ZAI and MiMo. Agent models and fallbacks: shared/managed-agents.ts.
// Credit: one CreditLedger per workspace, $5 promotional credit, runs pause at $0; container time
// is billed at the check-minute rate. Transcripts (redacted) in R2 {prefix}-managed-transcripts.
// Secrets: MANAGED_VAULT_KEY (required: 64 hex characters, generated once and kept; seals each
// repository's stored agent token and webhook secret, so losing it means re-enabling agents).
// Optional: AI_GATEWAY_TOKEN, the gateway's token when it is authenticated; MANAGED_ADMIN_TOKEN,
// bearer for POST /admin/accounts/<workspace>/credit (unset: nobody may grant).
// Card billing (Stripe): STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET (optional together; unset:
// "coming"). Stripe's webhook endpoint is https://managed.dev.yonedarepo.com/stripe/webhook, events
// setup_intent.succeeded, payment_intent.succeeded, payment_intent.payment_failed. A saved card
// unlocks PROMO_CREDIT_USD once; a balance under $5 is topped up by $20 off-session.
// ADMIN_BILLING=on (with the platform Worker's) adds the operators' billing routes, the nightly
// reconcile and three webhook events: charge.refunded, charge.dispute.created, charge.dispute.closed.
// Refunds use STRIPE_REFUND_KEY (optional secret: a restricted key, Refunds write) or else STRIPE_SECRET_KEY,
// bounded by the vars REFUND_MAX_USD and REFUND_DAILY_USD (per refund,
// and per UTC day across all accounts; unset: every refund is refused).
// REVENUE is this Worker's own D1, never the platform's: each ledger pushes its changed days to it
// with ADMIN_BILLING on (managed/ledger-rollup.ts); the platform reads /admin/billing/revenue.
// Deployed before the front Worker, which binds it as MANAGED.
// REQUEST_IDS=on puts the request id on every response and carries it to Durable Objects, queue jobs and containers (worker/request-scope.ts). Off, failure lines still carry it and nothing else changes. No order to deploy in: a message or request without it mints one.
// nodejs_als gives this Worker AsyncLocalStorage, and nothing else of Node, for the shared logger (worker/log.ts).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "containers": [
    {
      "class_name": "HarnessContainer",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./containers/harness/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 5,
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "REVENUE",
      "database_id": "22b3dcc3-4851-4642-80db-265b67f2d8b2",
      "database_name": "yonedarepo-dev-managed-revenue",
      "migrations_dir": "managed/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RepoAgents",
        "name": "REPOS"
      },
      {
        "class_name": "WorkspaceAgents",
        "name": "WORKSPACES"
      },
      {
        "class_name": "CreditLedger",
        "name": "LEDGER"
      },
      {
        "class_name": "HarnessContainer",
        "name": "HARNESS"
      }
    ]
  },
  "main": "managed/index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RepoAgents",
        "WorkspaceAgents",
        "CreditLedger",
        "HarnessContainer"
      ],
      "tag": "v1"
    }
  ],
  "name": "yonedarepo-dev-agents-managed",
  "observability": {
    "enabled": true
  },
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "yonedarepo-dev-managed-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "queue": "yonedarepo-dev-managed-runs"
      }
    ],
    "producers": [
      {
        "binding": "RUNS",
        "queue": "yonedarepo-dev-managed-runs"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "TRANSCRIPTS",
      "bucket_name": "yonedarepo-dev-managed-transcripts"
    }
  ],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "managed.dev.yonedarepo.com"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "CLAUDE_KEY",
      "secret_name": "Claude",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "CODEX_KEY",
      "secret_name": "Codex",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "ZAI_KEY",
      "secret_name": "ZAI",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "MIMO_KEY",
      "secret_name": "MiMo",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    }
  ],
  "services": [
    {
      "binding": "PLATFORM",
      "service": "yonedarepo-dev-platform"
    }
  ],
  "tail_consumers": [
    {
      "service": "yonedarepo-dev-superfan"
    }
  ],
  "vars": {
    "ADMIN_BILLING": "on",
    "AI_GATEWAY_PROVIDERS": "claude=anthropic,codex=openai,zai=custom-zai,mimo=custom-mimo",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f011d0ee02b23cad26b4b38151b204ad/yonedarepo-dev-managed-agents",
    "FAST_AGENTS_LIST": "on",
    "PROMO_CREDIT_USD": "100",
    "PUBLIC_URL": "https://managed.dev.yonedarepo.com",
    "REFUND_DAILY_USD": "1000",
    "REFUND_MAX_USD": "500",
    "REQUEST_IDS": "off"
  },
  "workers_dev": false,
  "workflows": [
    {
      "binding": "REVIEWS",
      "class_name": "ManagedReviewWorkflow",
      "name": "yonedarepo-dev-managed-reviews"
    }
  ]
}
