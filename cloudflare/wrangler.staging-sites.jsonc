// Staging website previews for the dev.yonedarepo.com stack: wrangler.sites.jsonc bound to the
// staging agent Worker and its bucket instead of production. workers.dev only; the agent
// Worker's SITE_ORIGIN points here.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yonedarepo-staging-sites",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "main": "sites/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "yonedarepo-staging-agents-objects" }],
  "services": [{ "binding": "PLATFORM", "service": "yonedarepo-staging-agents" }],
  "observability": { "enabled": true }
}
