// Generated from infra/envs/prod.json by `cargo xtask infra up`; edit the spec, not this file.
// Production platform Worker (yonedarepo.com): the same source platform as dev's
// (infra/envs/dev.json), with its own Durable Object namespaces, Artifacts namespace, R2, D1,
// queues, workflow, check containers and secrets. Browsers reach it through the front Worker's
// /api/v1 proxy (PLATFORM service binding); api.yonedarepo.com is its own hostname (Custom
// Domain plus the exact route);
// WEB_ORIGIN is where people approve device logins (/device). Secrets, set from stdin:
// OWNER_TOKEN  production owner credential (~/.config/yonedarepo/prod.env)
// Placed next to the data (aws:us-east-1, R2 and CheckContainer in ENAM), batched landing.
// PUSH_BUNDLES=on writes a large push's objects as bundles (one R2 object per batch, indexed by the repository authority); dev measured a 12,000-file push at 4.9 s (489 s without). Turn it off before rolling back below the bundle reader.
// BLOB_WRITE_THROUGH=on writes each API commit's blobs to R2 after the commit's own I/O, so burst read-backs skip the commit shards; off leaves them to the shard drain. Off since 2026-10-28: 6 interleaved dev bursts gave land p95 1.7-2.1 s off vs 2.7-3.2 s on, with read p95 0.18-0.32 s off (target < 2 s).
// Check runs: one per invocation, up to check_instances (4) at once.
// Model checks call the review model with REVIEW_MODEL_KEY, the managed Z.ai key (Secrets Store
// secret ZAI), bound to the platform Worker itself.
// The production superfan (wrangler.prod-superfan.jsonc) receives this Worker's tail events.
// Git LFS (/git/<repo>.git/info/lfs) hands out presigned R2 URLs on the OBJECTS bucket's S3 API
// (LFS_S3_ENDPOINT, LFS_S3_BUCKET). Secrets: LFS_S3_ACCESS_KEY_ID / LFS_S3_SECRET_ACCESS_KEY, the
// S3 key pair of an R2 API token with Object Read & Write on that bucket only. Without them LFS answers 501.
// Clone packs (platform-pack-builder.ts): one PackBuilder container per repository (cloudflare/pack-builder/Dockerfile,
// its own image: yoneda-pack-builder and stock Git), started for each pack-build job and destroyed after it.
// No internet or credentials: it reaches the repository's Artifacts mirror and the platform's smart HTTP only
// through this Worker. basic: svelte's three packs (168,943 objects) peak at 386 MiB, 675 MiB rebuilding every delta.
// Git over SSH (platform-ssh-gateway.ts): one SshGateway container (cloudflare/ssh-gateway/Dockerfile,
// its own image, never the runtime's) runs yoneda-ssh-gateway, reaching the platform only through SELF.
// SSH_FRONT_DOOR=tunnel. tunnel: the container also runs cloudflared (SSH_TUNNEL_TOKEN, a remotely
// managed tunnel whose route sends ssh.yonedarepo.com to ssh://localhost:2222, with no Access application so
// `cloudflared access ssh` connects without a login); the cron below keeps it running (about $7 a
// month on basic). connect: inbound TCP to this Worker (Spectrum, private beta). off: no container.
// Secrets: SSH_GATEWAY_SECRET (32+ random characters), SSH_HOST_ED25519_KEY / SSH_HOST_ECDSA_KEY
// (base64 of OpenSSH host key files, generated once and kept), SSH_TUNNEL_TOKEN (the tunnel's token).
// Welcome email (account-email.ts): the platform-jobs consumer sends one per new account through
// Resend (EMAIL_FROM, EMAIL_CONTACT). Its key is RESEND_API_KEY, the Secrets Store secret
// Resend-Yoneda, read at send time; without it email is off and sign-up never depends on it.
// The sending domain has open and click tracking off in Resend.
// Admin pages (/api/v1/admin, admin-api.ts): ADMIN_ACCOUNTS lists the operator accounts (comma separated; empty: only OWNER_TOKEN/Access). The sign-up notice goes to ADMIN_NOTIFY_EMAIL (empty: EMAIL_CONTACT). Credit grants and balances call the managed Worker's /admin/accounts/<account>/credit over MANAGED with MANAGED_ADMIN_TOKEN (optional secret, the managed Worker's own value; unset: grants are refused). MANAGED binds the managed Worker, which binds this one as PLATFORM: a fresh environment deploys this Worker once without MANAGED first.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "yonedarepo-prod",
      "remote": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "CheckContainer",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "SshGateway",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./ssh-gateway/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "PackBuilder",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./pack-builder/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_id": "0d2ef2d4-c105-4802-847f-d308c80833b4",
      "database_name": "yonedarepo-prod-platform-index",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "WorkspaceAuthority",
        "name": "WORKSPACES"
      },
      {
        "class_name": "SourceRepository",
        "name": "SOURCE_REPOS"
      },
      {
        "class_name": "CheckContainer",
        "name": "CHECK_RUNNERS"
      },
      {
        "class_name": "ObjectPushQueue",
        "name": "OBJECT_PUSHES"
      },
      {
        "class_name": "CommitShard",
        "name": "COMMIT_SHARDS"
      },
      {
        "class_name": "LandCombiner",
        "name": "LAND_COMBINERS"
      },
      {
        "class_name": "SshGateway",
        "name": "SSH_GATEWAYS"
      },
      {
        "class_name": "PackBuilder",
        "name": "PACK_BUILDERS"
      }
    ]
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 50000
  },
  "main": "worker/platform-index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "SourceRepository",
        "WorkspaceAuthority",
        "CheckContainer"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "ObjectPushQueue"
      ],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": [
        "CommitShard"
      ],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": [
        "LandCombiner"
      ],
      "tag": "v4"
    },
    {
      "new_sqlite_classes": [
        "SshGateway"
      ],
      "tag": "v5"
    },
    {
      "new_sqlite_classes": [
        "PackBuilder"
      ],
      "tag": "v6"
    }
  ],
  "name": "yonedarepo-prod-platform",
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "yonedarepo-prod-platform-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_concurrency": 20,
        "max_retries": 3,
        "queue": "yonedarepo-prod-platform-jobs"
      },
      {
        "dead_letter_queue": "yonedarepo-prod-platform-dead-letter",
        "max_batch_size": 1,
        "max_concurrency": 4,
        "max_retries": 3,
        "queue": "yonedarepo-prod-platform-checks"
      }
    ],
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yonedarepo-prod-platform-jobs"
      },
      {
        "binding": "PLATFORM_CHECKS",
        "queue": "yonedarepo-prod-platform-checks"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "yonedarepo-prod-platform-objects"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "api.yonedarepo.com"
    },
    {
      "pattern": "https://api.yonedarepo.com/*",
      "zone_name": "yonedarepo.com"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "REVIEW_MODEL_KEY",
      "secret_name": "ZAI",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "RESEND_API_KEY",
      "secret_name": "Resend-Yoneda",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    }
  ],
  "services": [
    {
      "binding": "SELF",
      "service": "yonedarepo-prod-platform"
    },
    {
      "binding": "MANAGED",
      "service": "yonedarepo-prod-agents-managed"
    }
  ],
  "tail_consumers": [
    {
      "service": "yonedarepo-prod-superfan"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ADMIN_ACCOUNTS": "",
    "ADMIN_NOTIFY_EMAIL": "",
    "ARTIFACTS_NAMESPACE": "yonedarepo-prod",
    "BLOB_WRITE_THROUGH": "off",
    "EMAIL_CONTACT": "hello@yonedarepo.com",
    "EMAIL_FROM": "YonedaRepo <hello@yonedarepo.com>",
    "LAND_MODE": "batch",
    "LFS_S3_BUCKET": "yonedarepo-prod-platform-objects",
    "LFS_S3_ENDPOINT": "https://f011d0ee02b23cad26b4b38151b204ad.r2.cloudflarestorage.com",
    "PUSH_BUNDLES": "on",
    "SSH_FRONT_DOOR": "tunnel",
    "SSH_HOST": "ssh.yonedarepo.com",
    "WEB_ORIGIN": "https://yonedarepo.com",
    "WORKERS_SUBDOMAIN": "mlong-f01"
  },
  "workers_dev": true,
  "workflows": [
    {
      "binding": "PLATFORM_IMPORT",
      "class_name": "PlatformImportWorkflow",
      "name": "yonedarepo-prod-platform-import"
    }
  ]
}
