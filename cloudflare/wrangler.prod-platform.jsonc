// Generated from infra/envs/prod.json by `cargo xtask infra up`; edit the spec, not this file.
// Production platform Worker (yonedarepo.com): the same source platform as dev's
// (infra/envs/dev.json), with its own Durable Object namespaces, R2, D1,
// queues, workflow, check containers and secrets. Browsers reach it through the front Worker's
// /api/v1 proxy (PLATFORM service binding); api.yonedarepo.com is its own hostname (Custom
// Domain plus the exact route);
// WEB_ORIGIN is where people approve device logins (/device). Secrets, set from stdin:
// OWNER_TOKEN  production owner credential (~/.config/yonedarepo/prod.env)
// Placed next to the data (aws:us-east-1, R2 and CheckContainer in ENAM), batched landing.
// PUSH_BUNDLES=on writes a large push's objects as bundles (one R2 object per batch, indexed by the repository authority); dev measured a 12,000-file push at 4.9 s (489 s without). Turn it off before rolling back below the bundle reader.
// ACCOUNT_SEARCH=on keeps a search summary per repository in its owner's directory (search:<owner> instances of WorkspaceAuthority) and serves GET /api/v1/search, the search_repos MCP tool and the CLI's search --all; off writes none and the route answers 404, so the website asks each repository itself as before.
// AUDIT_LOG=on keeps organizations' audit logs (audit:<org> instances of WorkspaceAuthority) and people's sign-in events; off writes neither and /orgs/:org/audit answers 404. Set it on this Worker and the front Worker together: sign-ins go through both.
// BLOB_WRITE_THROUGH=on writes each API commit's blobs to R2 after the commit's own I/O, so burst read-backs skip the commit shards; off leaves them to the shard drain. Off since 2026-10-28: 6 interleaved dev bursts gave land p95 1.7-2.1 s off vs 2.7-3.2 s on, with read p95 0.18-0.32 s off (target < 2 s).
// Check runs: one per invocation, up to check_instances (4) at once.
// Model checks call the review model with REVIEW_MODEL_KEY, the managed Z.ai key (Secrets Store
// secret ZAI), bound to the platform Worker itself.
// The production superfan (wrangler.prod-superfan.jsonc) receives this Worker's tail events.
// Git LFS (/git/<repo>.git/info/lfs) hands out presigned R2 URLs on the OBJECTS bucket's S3 API
// (LFS_S3_ENDPOINT, LFS_S3_BUCKET). Secrets: LFS_S3_ACCESS_KEY_ID / LFS_S3_SECRET_ACCESS_KEY, the
// S3 key pair of an R2 API token with Object Read & Write on that bucket only. Without them LFS answers 501.
// Clone packs (platform-pack-builder.ts): one PackBuilder container per repository (cloudflare/pack-builder/Dockerfile,
// its own image: yoneda-pack-builder and stock Git), started for each pack-build job and destroyed after it.
// No internet or credentials: it reaches an import's stored pack and the platform's smart HTTP only
// through this Worker. basic: svelte's three packs (168,943 objects) peak at 386 MiB, 675 MiB rebuilding every delta.
// Git over SSH (platform-ssh-gateway.ts): one SshGateway container (cloudflare/ssh-gateway/Dockerfile,
// its own image, never the runtime's) runs yoneda-ssh-gateway, reaching the platform only through SELF.
// SSH_FRONT_DOOR=tunnel. tunnel: the container also runs cloudflared (SSH_TUNNEL_TOKEN, a remotely
// managed tunnel whose route sends ssh.yonedarepo.com to ssh://localhost:2222, with no Access application so
// `cloudflared access ssh` connects without a login); the cron below keeps it running (about $7 a
// month on basic). connect: inbound TCP to this Worker (Spectrum, private beta). off: no container.
// Secrets: SSH_GATEWAY_SECRET (32+ random characters), SSH_HOST_ED25519_KEY / SSH_HOST_ECDSA_KEY
// (base64 of OpenSSH host key files, generated once and kept), SSH_TUNNEL_TOKEN (the tunnel's token).
// Welcome email (account-email.ts): the platform-jobs consumer sends one per new account through
// Resend (EMAIL_FROM, EMAIL_CONTACT). Its key is RESEND_API_KEY, the Secrets Store secret
// Resend-Yoneda, read at send time; without it email is off and sign-up never depends on it.
// The sending domain has open and click tracking off in Resend.
// Contact support (platform-support.ts) emails SUPPORT_EMAIL through Resend from EMAIL_FROM; without it the form answers 503.
// Site traffic (worker/platform-site-traffic.ts) reads the front Worker's yonedarepo_prod_site_events dataset (SITE_EVENTS_DATASET)
// through the Analytics Engine SQL API: CF_ACCOUNT_ID plus the optional secret ANALYTICS_READ_TOKEN (Account Analytics Read).
// The same dataset's SITE_EVENTS binding takes platform requests by client kind (worker/platform-client-events.ts) while TRAFFIC_EVENTS is on.
// It also takes sampled write origins (worker/platform-write-origin.ts) while REGION_SIGNALS is on; that switch stays off until the owner clears the privacy text.
// Without the token, traffic reports are unavailable and nothing else changes.
// ADMIN_BILLING=on adds the operators' billing routes (platform-admin-billing.ts) and starts the managed Worker's nightly reconcile from this Worker's cron; set it on the managed Worker too.
// LANDING_INSTRUMENTS=on: a change's page shows its Slop and Risk cards (repo-instruments.ts).
// LAND_WHEN_CLEARED=on: what can clear a Landing queues a platform_land_check job, and a repository can turn on Land when cleared (repo-land-check.ts). Set it only once every Worker on the queue knows the job: deploy with it off first (docs/runbook.md).
// AGENT_SIGNUP=on: yoneda login --agent <name> signs an agent up through the device flow (worker/platform-tokens.ts). Off, a code asking for an agent is refused; agents already signed up keep working.
// NEWSLETTER=on opens the Flight log sign-up at /updates (worker/platform-newsletter.ts, D1 newsletter_subscribers). It needs the optional secret NEWSLETTER_KEY, which signs unsubscribe links: never change it while the list is in use. Unset, off or without the key: no form, nothing stored, nothing sent. privacy.md must list this data first (docs/runbook.md).
// Admin pages (/api/v1/admin, platform-admin.ts): ADMIN_ACCOUNTS lists the operator accounts (comma separated; empty: only OWNER_TOKEN/Access). The sign-up notice goes to ADMIN_NOTIFY_EMAIL (empty: EMAIL_CONTACT). Credit grants and balances call the managed Worker's /admin/accounts/<account>/credit over MANAGED with MANAGED_ADMIN_TOKEN (optional secret, the managed Worker's own value; unset: grants are refused). MANAGED binds the managed Worker, which binds this one as PLATFORM: a fresh environment deploys this Worker once without MANAGED first.
// REQUEST_IDS=on puts the request id on every response and carries it to Durable Objects, queue jobs and containers (worker/request-scope.ts). Off, failure lines still carry it and nothing else changes. No order to deploy in: a message or request without it mints one.
// SPAN_SAMPLE=<N> keeps the Server-Timing phases of 1 request in N, and of every request over 5 seconds, as a request.spans log line and one SITE_EVENTS point, after the answer (worker/repo-span-sample.ts). off keeps none.
// SERVICE_LEVELS=on writes one SITE_EVENTS point per landing, clone, push and repository create and per 10 API reads, after the answer, for the admin page (shared/service-levels.ts). Set it on this Worker and Superfan together. Budget: docs/observability-plan.md.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "analytics_engine_datasets": [
    {
      "binding": "SITE_EVENTS",
      "dataset": "yonedarepo_prod_site_events"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "CheckContainer",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "ImportContainer",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-3",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "SshGateway",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./ssh-gateway/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "PackBuilder",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./pack-builder/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_id": "0d2ef2d4-c105-4802-847f-d308c80833b4",
      "database_name": "yonedarepo-prod-platform-index",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "WorkspaceAuthority",
        "name": "WORKSPACES"
      },
      {
        "class_name": "SourceRepository",
        "name": "SOURCE_REPOS"
      },
      {
        "class_name": "CheckContainer",
        "name": "CHECK_RUNNERS"
      },
      {
        "class_name": "ImportContainer",
        "name": "IMPORT_RUNNERS"
      },
      {
        "class_name": "CommitShard",
        "name": "COMMIT_SHARDS"
      },
      {
        "class_name": "LandCombiner",
        "name": "LAND_COMBINERS"
      },
      {
        "class_name": "SshGateway",
        "name": "SSH_GATEWAYS"
      },
      {
        "class_name": "PackBuilder",
        "name": "PACK_BUILDERS"
      }
    ]
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 50000
  },
  "main": "worker/platform-index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "SourceRepository",
        "WorkspaceAuthority",
        "CheckContainer"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "ObjectPushQueue"
      ],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": [
        "CommitShard"
      ],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": [
        "LandCombiner"
      ],
      "tag": "v4"
    },
    {
      "new_sqlite_classes": [
        "SshGateway"
      ],
      "tag": "v5"
    },
    {
      "new_sqlite_classes": [
        "PackBuilder"
      ],
      "tag": "v6"
    },
    {
      "deleted_classes": [
        "ObjectPushQueue"
      ],
      "tag": "v7"
    },
    {
      "new_sqlite_classes": [
        "ImportContainer"
      ],
      "tag": "v8"
    }
  ],
  "name": "yonedarepo-prod-platform",
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "yonedarepo-prod-platform-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_concurrency": 20,
        "max_retries": 3,
        "queue": "yonedarepo-prod-platform-jobs"
      },
      {
        "dead_letter_queue": "yonedarepo-prod-platform-dead-letter",
        "max_batch_size": 1,
        "max_concurrency": 4,
        "max_retries": 3,
        "queue": "yonedarepo-prod-platform-checks"
      }
    ],
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yonedarepo-prod-platform-jobs"
      },
      {
        "binding": "PLATFORM_CHECKS",
        "queue": "yonedarepo-prod-platform-checks"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "yonedarepo-prod-platform-objects"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "api.yonedarepo.com"
    },
    {
      "pattern": "https://api.yonedarepo.com/*",
      "zone_name": "yonedarepo.com"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "REVIEW_MODEL_KEY",
      "secret_name": "ZAI",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "RESEND_API_KEY",
      "secret_name": "Resend-Yoneda",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    }
  ],
  "services": [
    {
      "binding": "SELF",
      "service": "yonedarepo-prod-platform"
    },
    {
      "binding": "MANAGED",
      "service": "yonedarepo-prod-agents-managed"
    }
  ],
  "tail_consumers": [
    {
      "service": "yonedarepo-prod-superfan"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ACCOUNT_SEARCH": "on",
    "ADMIN_ACCOUNTS": "magnetonio",
    "ADMIN_BILLING": "on",
    "ADMIN_NOTIFY_EMAIL": "",
    "AGENT_SIGNUP": "on",
    "AUDIT_LOG": "off",
    "BLOB_WRITE_THROUGH": "off",
    "CF_ACCOUNT_ID": "f011d0ee02b23cad26b4b38151b204ad",
    "EMAIL_CONTACT": "hello@yonedarepo.com",
    "EMAIL_FROM": "YonedaRepo <hello@yonedarepo.com>",
    "LANDING_INSTRUMENTS": "on",
    "LAND_MODE": "batch",
    "LAND_WHEN_CLEARED": "on",
    "LEGAL_HOLD": "on",
    "LFS_S3_BUCKET": "yonedarepo-prod-platform-objects",
    "LFS_S3_ENDPOINT": "https://f011d0ee02b23cad26b4b38151b204ad.r2.cloudflarestorage.com",
    "NEWSLETTER": "on",
    "PACK_CACHE": "on",
    "PUSH_BUNDLES": "on",
    "REGION_SIGNALS": "off",
    "REPO_ERASE": "on",
    "REPO_SIZE_GUARD": "on",
    "REPO_STORAGE_GUARD": "on",
    "REPO_UNDO_DAYS": "30",
    "REQUEST_IDS": "off",
    "SERVICE_LEVELS": "on",
    "SITE_EVENTS_DATASET": "yonedarepo_prod_site_events",
    "SPAN_SAMPLE": "off",
    "SSH_FRONT_DOOR": "tunnel",
    "SSH_HOST": "ssh.yonedarepo.com",
    "SUPPORT_EMAIL": "support@yonedalabs.ai",
    "TRAFFIC_EVENTS": "on",
    "TRAFFIC_REPORT": "on",
    "WEB_ORIGIN": "https://yonedarepo.com",
    "WORKERS_SUBDOMAIN": "mlong-f01"
  },
  "workers_dev": true,
  "workflows": [
    {
      "binding": "PLATFORM_IMPORT",
      "class_name": "PlatformImportWorkflow",
      "name": "yonedarepo-prod-platform-import"
    }
  ]
}
