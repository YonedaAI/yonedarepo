// Generated from infra/envs/dev.json by `cargo xtask infra up`; edit the spec, not this file.
// GITHUB_APP_ID, GITHUB_APP_SLUG and the optional secret GITHUB_APP_PRIVATE_KEY (the App's PEM): the GitHub App that reads private repositories for an import (worker/platform-github-app.ts). Any unset: no Connect, public imports only. App setup URL: https://dev.yonedarepo.com/github/connected.
// Dev platform Worker (dev.yonedarepo.com stack): the source platform, with its own
// Durable Object namespaces, R2,
// D1, queues, workflow, check containers and secrets, so it shares nothing with production
// (yonedarepo-prod-*). Browsers reach it through the dev front Worker's
// /api/v1 proxy (PLATFORM service binding); workers.dev stays on for direct API benches.
// OWNER_TOKEN  dev-only owner credential (~/.config/yonedarepo/staging.env, name kept)
// The global entry dispatches default fetch to the API region nearest the caller.
// Fetch-only regional aliases share these original authorities and storage bindings.
// Repository data and queue ownership stay with the platform authorities.
// The dev superfan (wrangler.dev-superfan.jsonc) receives this Worker's tail
// events: outcomes, logs, exceptions and CPU/wall time, with no API token.
// Batched landing, with commits beginning from and main reads served by the published
// head. No LAND_MODE_OVERRIDE: per-request mode headers are for benches only.
// PUSH_BUNDLES=on writes a large push's objects as bundles (one R2 object per batch, indexed by the repository authority). Turn it off before rolling back below the bundle reader.
// PACK_CACHE=on serves a clone's pack (full, partial, shallow, or a partial clone's checkout) from a stored copy (derived/v1/<repo>/packs/), stored by the first such clone or by a pack-build job it hands off to, and built for main's tip by a job a minute after a push (repositories of 5,000+ objects; PACK_BUILD_MIN_OBJECTS); off builds every pack from the bundles.
// ACCOUNT_SEARCH=on keeps a search summary per repository in its owner's directory (search:<owner> instances of WorkspaceAuthority) and serves GET /api/v1/search, the search_repos MCP tool and the CLI's search --all; off writes none and the route answers 404, so the website asks each repository itself as before.
// AUDIT_LOG=on keeps organizations' audit logs (audit:<org> instances of WorkspaceAuthority) and people's sign-in events; off writes neither and /orgs/:org/audit answers 404. Set it on this Worker and the front Worker together: sign-ins go through both.
// BLOB_WRITE_THROUGH=on writes each API commit's blobs to R2 after the commit's own I/O, so burst read-backs skip the commit shards; off leaves them to the shard drain. Off since 2026-10-28: 6 interleaved dev bursts gave land p95 1.7-2.1 s off vs 2.7-3.2 s on, with read p95 0.18-0.32 s off (target < 2 s).
// Check runs take minutes (container start, the check): one per invocation, up to
// the container limit (4) at once, apart from the derive and projection jobs above.
// api.dev.yonedarepo.com is the platform API's own hostname (Custom Domain plus the exact route); WEB_ORIGIN is where people approve device logins (/device).
// Model checks call the review model with REVIEW_MODEL_KEY, the managed Z.ai key (Secrets Store secret ZAI, the same store key the front Worker's managed connections use), bound to the platform Worker itself.
// Git LFS (/git/<repo>.git/info/lfs) hands out presigned R2 URLs on the OBJECTS bucket's S3 API
// (LFS_S3_ENDPOINT, LFS_S3_BUCKET). Secrets: LFS_S3_ACCESS_KEY_ID / LFS_S3_SECRET_ACCESS_KEY, the
// S3 key pair of an R2 API token with Object Read & Write on that bucket only. Without them LFS answers 501.
// Clone packs (platform-pack-builder.ts): one PackBuilder container per repository (cloudflare/pack-builder/Dockerfile,
// its own image: yoneda-pack-builder and stock Git), started for each pack-build job and destroyed after it.
// No internet or credentials: it reaches an import's stored pack and the platform's smart HTTP only
// through this Worker. basic: svelte's three packs (168,943 objects) peak at 386 MiB, 675 MiB rebuilding every delta.
// Git over SSH (platform-ssh-gateway.ts): one SshGateway container (cloudflare/ssh-gateway/Dockerfile,
// its own image, never the runtime's) runs yoneda-ssh-gateway, reaching the platform only through SELF.
// SSH_FRONT_DOOR=tunnel. tunnel: the container also runs cloudflared (SSH_TUNNEL_TOKEN, a remotely
// managed tunnel whose route sends ssh.dev.yonedarepo.com to ssh://localhost:2222, with no Access application so
// `cloudflared access ssh` connects without a login); the cron below keeps it running (about $7 a
// month on basic). connect: inbound TCP to this Worker (Spectrum, private beta). off: no container.
// Secrets: SSH_GATEWAY_SECRET (32+ random characters), SSH_HOST_ED25519_KEY / SSH_HOST_ECDSA_KEY
// (base64 of OpenSSH host key files, generated once and kept), SSH_TUNNEL_TOKEN (the tunnel's token).
// Welcome email (account-email.ts): the platform-jobs consumer sends one per new account through
// Resend (EMAIL_FROM, EMAIL_CONTACT). Its key is RESEND_API_KEY, the Secrets Store secret
// Resend-Yoneda, read at send time; without it email is off and sign-up never depends on it.
// The sending domain has open and click tracking off in Resend.
// Contact support (platform-support.ts) emails SUPPORT_EMAIL through Resend from EMAIL_FROM; without it the form answers 503.
// Site traffic (worker/platform-site-traffic.ts) reads the front Worker's yonedarepo_dev_site_events dataset (SITE_EVENTS_DATASET)
// through the Analytics Engine SQL API: CF_ACCOUNT_ID plus the optional secret ANALYTICS_READ_TOKEN (Account Analytics Read).
// The same dataset's SITE_EVENTS binding takes platform requests by client kind (worker/platform-client-events.ts) while TRAFFIC_EVENTS is on.
// It also takes sampled write origins (worker/platform-write-origin.ts) while REGION_SIGNALS is on, as it is on dev (global regions, R1).
// REGION_HINT_TEST=on lets a create of a new repository named region-hint-* ask for a Durable Object location hint and adds GET /repos/<id>/where (repo-region-hint.ts), for the latency matrix; off, neither exists. Dev only: prod has no such variable.
// Without the token, traffic reports are unavailable and nothing else changes.
// ADMIN_BILLING=on adds the operators' billing routes (platform-admin-billing.ts) and starts the managed Worker's nightly reconcile from this Worker's cron; set it on the managed Worker too.
// LANDING_INSTRUMENTS=on: a change's page shows its Slop and Risk cards (repo-instruments.ts).
// REPO_STORAGE_GUARD=on: a repository whose history database reaches 9.4 GB answers 507 REPO_FULL to new work; reads, deletes and accepted work go on (docs/runbook.md).
// REPO_SIZE_GUARD=on: a repository whose Git objects reach the published 10 GB answers 507 REPO_SIZE_LIMIT to pushes and new commits (docs/runbook.md).
// LAND_WHEN_CLEARED=on: what can clear a Landing queues a platform_land_check job, and a repository can turn on Land when cleared (repo-land-check.ts). Set it only once every Worker on the queue knows the job: deploy with it off first (docs/runbook.md).
// AGENT_SIGNUP=on: yoneda login --agent <name> signs an agent up through the device flow (worker/platform-tokens.ts). Off, a code asking for an agent is refused; agents already signed up keep working.
// NEWSLETTER=on opens the Flight log sign-up at /updates (worker/platform-newsletter.ts, D1 newsletter_subscribers). It needs the optional secret NEWSLETTER_KEY, which signs unsubscribe links: never change it while the list is in use. Unset, off or without the key: no form, nothing stored, nothing sent. privacy.md must list this data first (docs/runbook.md).
// LEGAL_HOLD=on refuses every destructive path of a held repository or org and opens the hold routes (worker/platform-legal-hold.ts).
// Admin pages (/api/v1/admin, platform-admin.ts): ADMIN_ACCOUNTS lists the operator accounts (comma separated; empty: only OWNER_TOKEN/Access). The sign-up notice goes to ADMIN_NOTIFY_EMAIL (empty: EMAIL_CONTACT). Credit grants and balances call the managed Worker's /admin/accounts/<account>/credit over MANAGED with MANAGED_ADMIN_TOKEN (optional secret, the managed Worker's own value; unset: grants are refused). MANAGED binds the managed Worker, which binds this one as PLATFORM: a fresh environment deploys this Worker once without MANAGED first.
// REQUEST_IDS=on puts the request id on every response and carries it to Durable Objects, queue jobs and containers (worker/request-scope.ts). Off, failure lines still carry it and nothing else changes. No order to deploy in: a message or request without it mints one.
// SPAN_SAMPLE=<N> keeps the Server-Timing phases of 1 request in N, and of every request over 5 seconds, as a request.spans log line and one SITE_EVENTS point, after the answer (worker/repo-span-sample.ts). off keeps none.
// SERVICE_LEVELS=on writes one SITE_EVENTS point per landing, clone, push and repository create and per 10 API reads, after the answer, for the admin page (shared/service-levels.ts). Set it on this Worker and Superfan together. Budget: docs/observability-plan.md.
// REPO_ANALYTICS=on records admitted repository usage in the existing SITE_EVENTS point and enables Insights; TRAFFIC_EVENTS and TRAFFIC_REPORT must also be on. No historical usage is backfilled.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "analytics_engine_datasets": [
    {
      "binding": "SITE_EVENTS",
      "dataset": "yonedarepo_dev_site_events"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "CheckContainer",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "ImportContainer",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-3",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "SshGateway",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./ssh-gateway/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "PackBuilder",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./pack-builder/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_id": "ec419fb5-308e-4c52-8252-6d321302d771",
      "database_name": "yonedarepo-dev-platform-index",
      "migrations_dir": "migrations"
    },
    {
      "binding": "INDEX_WEUR",
      "database_id": "2c8c288e-8975-4b8f-955a-7e7e916fee7d",
      "database_name": "yonedarepo-dev-platform-index-weur"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "WorkspaceAuthority",
        "name": "WORKSPACES"
      },
      {
        "class_name": "SourceRepository",
        "name": "SOURCE_REPOS"
      },
      {
        "class_name": "CheckContainer",
        "name": "CHECK_RUNNERS"
      },
      {
        "class_name": "ImportContainer",
        "name": "IMPORT_RUNNERS"
      },
      {
        "class_name": "CommitShard",
        "name": "COMMIT_SHARDS"
      },
      {
        "class_name": "LandCombiner",
        "name": "LAND_COMBINERS"
      },
      {
        "class_name": "SshGateway",
        "name": "SSH_GATEWAYS"
      },
      {
        "class_name": "PackBuilder",
        "name": "PACK_BUILDERS"
      },
      {
        "class_name": "RepositoryReadCopy",
        "name": "READ_COPIES"
      }
    ]
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 50000
  },
  "main": "worker/platform-index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "SourceRepository",
        "WorkspaceAuthority",
        "CheckContainer"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "ObjectPushQueue"
      ],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": [
        "CommitShard"
      ],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": [
        "LandCombiner"
      ],
      "tag": "v4"
    },
    {
      "new_sqlite_classes": [
        "SshGateway"
      ],
      "tag": "v5"
    },
    {
      "new_sqlite_classes": [
        "PackBuilder"
      ],
      "tag": "v6"
    },
    {
      "deleted_classes": [
        "ObjectPushQueue"
      ],
      "tag": "v7"
    },
    {
      "new_sqlite_classes": [
        "ImportContainer"
      ],
      "tag": "v8"
    },
    {
      "new_sqlite_classes": [
        "RepositoryReadCopy"
      ],
      "tag": "v9"
    }
  ],
  "name": "yonedarepo-dev-platform",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.01
    }
  },
  "pipelines": [
    {
      "binding": "CHANGELOG",
      "stream": "4ff4b2c0c4ec4234934fa94498ab73c5"
    }
  ],
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "yonedarepo-dev-platform-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_concurrency": 20,
        "max_retries": 3,
        "queue": "yonedarepo-dev-platform-jobs"
      },
      {
        "dead_letter_queue": "yonedarepo-dev-platform-dead-letter",
        "max_batch_size": 1,
        "max_concurrency": 4,
        "max_retries": 3,
        "queue": "yonedarepo-dev-platform-checks"
      }
    ],
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yonedarepo-dev-platform-jobs"
      },
      {
        "binding": "PLATFORM_CHECKS",
        "queue": "yonedarepo-dev-platform-checks"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "yonedarepo-dev-platform-objects"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "api.dev.yonedarepo.com"
    },
    {
      "pattern": "https://api.dev.yonedarepo.com/*",
      "zone_name": "yonedarepo.com"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "REVIEW_MODEL_KEY",
      "secret_name": "ZAI",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "RESEND_API_KEY",
      "secret_name": "Resend-Yoneda",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    }
  ],
  "services": [
    {
      "binding": "SELF",
      "service": "yonedarepo-dev-platform"
    },
    {
      "binding": "MANAGED",
      "service": "yonedarepo-dev-agents-managed"
    },
    {
      "binding": "CELL_WEUR",
      "service": "yonedarepo-dev-platform-weur"
    },
    {
      "binding": "CELL_ENAM",
      "service": "yonedarepo-dev-api-enam"
    },
    {
      "binding": "API_ENAM",
      "service": "yonedarepo-dev-api-enam"
    },
    {
      "binding": "API_WEUR",
      "service": "yonedarepo-dev-api-weur"
    },
    {
      "binding": "API_APAC",
      "service": "yonedarepo-dev-api-apac"
    },
    {
      "binding": "API_OC",
      "service": "yonedarepo-dev-api-oc"
    },
    {
      "binding": "API_SAM",
      "service": "yonedarepo-dev-api-sam"
    },
    {
      "binding": "API_AFR",
      "service": "yonedarepo-dev-api-afr"
    }
  ],
  "tail_consumers": [
    {
      "service": "yonedarepo-dev-superfan"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "ACCOUNT_SEARCH": "on",
    "ADMIN_ACCOUNTS": "magnetonio,mlong168@gmail.com",
    "ADMIN_BILLING": "on",
    "ADMIN_NOTIFY_EMAIL": "",
    "AGENT_SIGNUP": "on",
    "AUDIT_LOG": "off",
    "AUTOMATIC_LOCALITY": "on",
    "BLOB_WRITE_THROUGH": "off",
    "CELLS": "on",
    "CF_ACCOUNT_ID": "f011d0ee02b23cad26b4b38151b204ad",
    "EDGE_FIRST_READS": "on",
    "EMAIL_CONTACT": "hello@yonedarepo.com",
    "EMAIL_FROM": "YonedaRepo (dev) <hello@yonedarepo.com>",
    "GITHUB_APP_ID": "5571444",
    "GITHUB_APP_SLUG": "yonedarepo-dev-import",
    "GLOBAL_AUTH_LIMITS": "on",
    "JOINED_REPO_PATH": "on",
    "LANDING_INSTRUMENTS": "on",
    "LAND_MODE": "batch",
    "LAND_WHEN_CLEARED": "on",
    "LEGAL_HOLD": "on",
    "LFS_S3_BUCKET": "yonedarepo-dev-platform-objects",
    "LFS_S3_ENDPOINT": "https://f011d0ee02b23cad26b4b38151b204ad.r2.cloudflarestorage.com",
    "NEWSLETTER": "on",
    "OVERVIEW_ADMITTED_SNAPSHOT": "on",
    "OVERVIEW_BOOTSTRAP": "on",
    "OVERVIEW_DEFER_ACTIVITY": "on",
    "PACK_CACHE": "on",
    "PUSH_BUNDLES": "on",
    "RECENT_VERSIONS": "on",
    "REGIONAL_API": "on",
    "REGION_HINT_TEST": "on",
    "REGION_SIGNALS": "on",
    "REPO_ANALYTICS": "on",
    "REPO_ERASE": "on",
    "REPO_IMAGE_REVALIDATION": "on",
    "REPO_SIZE_GUARD": "on",
    "REPO_STORAGE_GUARD": "on",
    "REPO_UNDO_DAYS": "30",
    "REQUEST_IDS": "off",
    "SEARCH_CODE_MEMO": "on",
    "SERVICE_LEVELS": "on",
    "SHARED_READ_TREES": "on",
    "SITE_EVENTS_DATASET": "yonedarepo_dev_site_events",
    "SPAN_SAMPLE": "off",
    "SSH_FRONT_DOOR": "tunnel",
    "SSH_HOST": "ssh.dev.yonedarepo.com",
    "SUPPORT_EMAIL": "support@yonedalabs.ai",
    "TRAFFIC_EVENTS": "on",
    "TRAFFIC_REPORT": "on",
    "WEB_ORIGIN": "https://dev.yonedarepo.com",
    "WORKERS_SUBDOMAIN": "mlong-f01"
  },
  "workers_dev": true,
  "workflows": [
    {
      "binding": "PLATFORM_IMPORT",
      "class_name": "PlatformImportWorkflow",
      "name": "yonedarepo-dev-platform-import"
    }
  ]
}
