// Generated from infra/envs/dev.json by `cargo xtask infra up`; edit the spec, not this file.
// Dev front Worker (name kept from the agent layer, removed 2026-10-27): it serves the browser
// app on dev.yonedarepo.com, account sign-in (/api/auth/*) and the owner session, and proxies
// /api/v1 to the dev platform through the PLATFORM service binding on the same origin. Accounts
// live in the platform's WorkspaceAuthority (WORKSPACES script binding). It has no stores or
// containers; it only sends new accounts' welcome-email jobs to the platform-jobs queue.
// OWNER_TOKEN  dev-only owner credential (~/.config/yonedarepo/staging.env, name kept)
// The exact route keeps dev.yonedarepo.com on this Worker (a route takes precedence over a
// Custom Domain on one hostname, and the most specific route pattern wins).
// v4 deletes the agent layer's Durable Object classes (RepositoryAuthority, LiveRoom,
// AgentSandbox) and their data; the agent-run code is on the agent-run-workspaces branch.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "assets": {
    "binding": "ASSETS",
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "WorkspaceAuthority",
        "name": "WORKSPACES",
        "script_name": "yonedarepo-dev-platform"
      }
    ]
  },
  "limits": {
    "subrequests": 50000
  },
  "main": "worker/front-index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RepositoryAuthority",
        "LiveRoom",
        "ExecutionContainer",
        "SourceWorkspaceAuthority"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "AgentSandbox"
      ],
      "tag": "v2"
    },
    {
      "deleted_classes": [
        "ExecutionContainer",
        "SourceWorkspaceAuthority"
      ],
      "tag": "v3"
    },
    {
      "deleted_classes": [
        "RepositoryAuthority",
        "LiveRoom",
        "AgentSandbox"
      ],
      "tag": "v4"
    }
  ],
  "name": "yonedarepo-dev-agents",
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  "preview_urls": false,
  "queues": {
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yonedarepo-dev-platform-jobs"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "dev.yonedarepo.com"
    },
    {
      "pattern": "https://dev.yonedarepo.com/*",
      "zone_name": "yonedarepo.com"
    }
  ],
  "services": [
    {
      "binding": "PLATFORM",
      "service": "yonedarepo-dev-platform"
    }
  ],
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://dev.yonedarepo.com"
  },
  "workers_dev": true
}
