        "binding": "AGENT_QUEUE",
        "queue": "yoneda-dev-agent"
      },
      {
        "binding": "CAPTURE_QUEUE",
        "queue": "yoneda-dev-capture"
      },
      {
        "binding": "EVALUATE_QUEUE",
        "queue": "yoneda-dev-evaluate"
      },
      {
        "binding": "PUBLISH_QUEUE",
        "queue": "yoneda-dev-publish"
      }
    ]
  },
  "r2_buckets": [
