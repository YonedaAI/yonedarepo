{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "yoneda-dev",
      "remote": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "ExecutionContainer",
      "image": "registry.cloudflare.com/f011d0ee02b23cad26b4b38151b204ad/yoneda-runtime-guided-r24@sha256:9376f412a2488a6a1da9e3b88090d821e2d7b1d6be46e6cfa009c16ce8c0aae2",
      "instance_type": "standard-1",
      "max_instances": 16,
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_id": "182c0b3e-8f82-4038-9b3e-630b0b5275c5",
      "database_name": "yonedarepo-dev-index",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RepositoryAuthority",
        "name": "REPOSITORIES"
      },
      {
        "class_name": "LiveRoom",
        "name": "LIVE"
      },
      {
        "class_name": "ExecutionContainer",
        "name": "EXECUTIONS"
      },
      {
        "class_name": "WorkspaceAuthority",
        "name": "WORKSPACES"
      },
      {
        "class_name": "SourceWorkspaceAuthority",
        "name": "SOURCES"
      }
    ]
  },
  "limits": {
    "subrequests": 50000
  },
  "main": "worker/index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RepositoryAuthority",
        "LiveRoom",
        "ExecutionContainer"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "WorkspaceAuthority"
      ],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": [
        "SourceWorkspaceAuthority"
      ],
      "tag": "v3"
    }
  ],
  "name": "yonedarepo-dev",
  "observability": {
    "enabled": true
  },
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "yoneda-dev-dead-letter",
        "max_batch_size": 1,
        "max_retries": 3,
        "queue": "yoneda-dev-agent"
      },
      {
        "dead_letter_queue": "yoneda-dev-dead-letter",
        "max_batch_size": 1,
        "max_retries": 3,
        "queue": "yoneda-dev-capture"
      },
      {
        "dead_letter_queue": "yoneda-dev-dead-letter",
        "max_batch_size": 1,
        "max_retries": 3,
        "queue": "yoneda-dev-evaluate"
      },
      {
        "dead_letter_queue": "yoneda-dev-dead-letter",
        "max_batch_size": 1,
        "max_retries": 3,
        "queue": "yoneda-dev-publish"
      }
    ],
    "producers": [
