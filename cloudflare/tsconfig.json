{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2024"
    ],
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "worker/**/*.ts",
    "sites/**/*.ts"
  ]
}
