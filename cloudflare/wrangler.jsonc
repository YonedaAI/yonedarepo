{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yonedarepo-dev",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "subrequests": 50000
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "yonedarepo.com",
      "custom_domain": true
    },
    {
      "pattern": "www.yonedarepo.com",
      "custom_domain": true
    },
    {
      "pattern": "https://www.yonedarepo.com/*",
      "zone_name": "yonedarepo.com"
    }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://yonedarepo.com",
    "ARTIFACTS_NAMESPACE": "yoneda-dev"
  },
  "services": [
    {
      "binding": "SELF",
      "service": "yonedarepo-dev"
    }
  ],
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "yoneda-dev",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceAuthority"
      },
      {
        "name": "SOURCE_REPOS",
        "class_name": "SourceRepository"
      },
      {
        "name": "CHECK_RUNNERS",
        "class_name": "CheckContainer"
      },
      {
        "name": "OBJECT_PUSHES",
        "class_name": "ObjectPushQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RepositoryAuthority",
        "LiveRoom",
        "ExecutionContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "WorkspaceAuthority"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "SourceWorkspaceAuthority"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "SourceRepository"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "CheckContainer"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "ObjectPushQueue"
      ]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": [
        "AgentSandbox"
      ]
    },
    {
      "tag": "v8",
      "deleted_classes": [
        "ExecutionContainer",
        "SourceWorkspaceAuthority"
      ]
    },
    {
      "tag": "v9",
      "deleted_classes": [
        "RepositoryAuthority",
        "LiveRoom",
        "AgentSandbox"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "CheckContainer",
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "max_instances": 8,
      "instance_type": "standard-1",
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "yonedarepo-dev-objects"
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "yonedarepo-dev-index",
      "database_id": "182c0b3e-8f82-4038-9b3e-630b0b5275c5",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yoneda-dev-platform"
      }
    ],
    "consumers": [
      {
        "queue": "yoneda-dev-platform",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "yoneda-dev-dead-letter"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "workflows": [
    {
      "name": "yonedarepo-dev-platform-import",
      "binding": "PLATFORM_IMPORT",
      "class_name": "PlatformImportWorkflow"
    }
  ]
}
