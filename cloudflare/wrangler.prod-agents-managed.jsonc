// Generated from infra/envs/prod.json by `cargo xtask infra up`; edit the spec, not this file.
// Production managed agents Worker (cloudflare/managed): YonedaRepo's maintained reviewers (code, security,
// slop review), run as an ordinary API client of the platform. A workspace owner enables an agent
// from the browser (front Worker /api/managed -> MANAGED service binding); the owner's own session
// mints each chosen repository's token (yoneda-managed-agents: read, review, check) and webhook
// (change, branch) to https://managed.yonedarepo.com/hooks/<repo>. That hostname serves only signed webhooks and
// /health. Runs are queued (RUNS, at least once) and run as one Workflow instance per run (REVIEWS):
// a HarnessContainer (cloudflare/containers/harness: Claude Code, Codex, opencode, pinned) with no
// internet clones the change lazily and runs the agent's CLI; its only ways out are the Worker's
// outbound handlers (platform reads with the token added, AI Gateway with the key added, metered
// per request). The Worker posts anchored comments, a summary and the agent's check.
// Model calls go through AI Gateway {prefix}-managed-agents (AI_GATEWAY_URL; slugs in
// AI_GATEWAY_PROVIDERS: anthropic and openai built in; custom-zai and custom-mimo are custom
// providers with base URLs https://api.z.ai and https://api.xiaomimimo.com). Keys: Secrets Store
// secrets Claude, Codex, ZAI and MiMo. Agent models and fallbacks: shared/managed-agents.ts.
// Credit: one CreditLedger per workspace, $5 promotional credit, runs pause at $0; container time
// is billed at the check-minute rate. Transcripts (redacted) in R2 {prefix}-managed-transcripts.
// Secrets: MANAGED_VAULT_KEY (required: 64 hex characters, generated once and kept; seals each
// repository's stored agent token and webhook secret, so losing it means re-enabling agents).
// Optional: AI_GATEWAY_TOKEN, the gateway's token when it is authenticated; MANAGED_ADMIN_TOKEN,
// bearer for POST /admin/accounts/<workspace>/credit (unset: nobody may grant).
// Card billing (Stripe): STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET (optional together; unset:
// "coming"). Stripe's webhook endpoint is https://managed.yonedarepo.com/stripe/webhook, events
// setup_intent.succeeded, payment_intent.succeeded, payment_intent.payment_failed. A saved card
// unlocks PROMO_CREDIT_USD once; a balance under $5 is topped up by $20 off-session.
// Deployed before the front Worker, which binds it as MANAGED.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "compatibility_date": "2026-10-07",
  "containers": [
    {
      "class_name": "HarnessContainer",
      "constraints": {
        "regions": [
          "ENAM"
        ]
      },
      "image": "./containers/harness/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 20,
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RepoAgents",
        "name": "REPOS"
      },
      {
        "class_name": "WorkspaceAgents",
        "name": "WORKSPACES"
      },
      {
        "class_name": "CreditLedger",
        "name": "LEDGER"
      },
      {
        "class_name": "HarnessContainer",
        "name": "HARNESS"
      }
    ]
  },
  "main": "managed/index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RepoAgents",
        "WorkspaceAgents",
        "CreditLedger",
        "HarnessContainer"
      ],
      "tag": "v1"
    }
  ],
  "name": "yonedarepo-prod-agents-managed",
  "observability": {
    "enabled": true
  },
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "yonedarepo-prod-managed-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "queue": "yonedarepo-prod-managed-runs"
      }
    ],
    "producers": [
      {
        "binding": "RUNS",
        "queue": "yonedarepo-prod-managed-runs"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "TRANSCRIPTS",
      "bucket_name": "yonedarepo-prod-managed-transcripts"
    }
  ],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "managed.yonedarepo.com"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "CLAUDE_KEY",
      "secret_name": "Claude",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "CODEX_KEY",
      "secret_name": "Codex",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "ZAI_KEY",
      "secret_name": "ZAI",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "MIMO_KEY",
      "secret_name": "MiMo",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    }
  ],
  "services": [
    {
      "binding": "PLATFORM",
      "service": "yonedarepo-prod-platform"
    }
  ],
  "vars": {
    "AI_GATEWAY_PROVIDERS": "claude=anthropic,codex=openai,zai=custom-zai,mimo=custom-mimo",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f011d0ee02b23cad26b4b38151b204ad/yonedarepo-prod-managed-agents",
    "PROMO_CREDIT_USD": "100",
    "PUBLIC_URL": "https://managed.yonedarepo.com"
  },
  "workers_dev": false,
  "workflows": [
    {
      "binding": "REVIEWS",
      "class_name": "ManagedReviewWorkflow",
      "name": "yonedarepo-prod-managed-reviews"
    }
  ]
}
