// Generated from infra/envs/prod.json by `cargo xtask infra up`; edit the spec, not this file.
// Production managed agents Worker (cloudflare/managed): YonedaRepo's predefined reviewers (code review,
// security review), run as an ordinary API client of the platform. A repository owner enables an
// agent from the browser (front Worker /api/managed -> MANAGED service binding); the owner's own
// session mints a scoped repository token (yoneda-managed-agents: read, review, check) and a
// webhook (change, branch) to https://managed.yonedarepo.com/hooks/<repo>. That hostname serves only signed
// webhooks and /health. Runs are queued (RUNS, at least once) and run as one Workflow instance per
// run (REVIEWS): load the change over the platform API, 3-6 model calls, then anchored comments,
// a summary and a code-review / security-review check on the head commit.
// Model calls go through AI Gateway {prefix}-managed-agents (AI_GATEWAY_URL; provider slugs in
// AI_GATEWAY_PROVIDERS: anthropic, custom-zai and custom-mimo, custom providers with base URLs
// https://api.z.ai and https://api.xiaomimimo.com). Keys: Secrets Store secrets Claude, ZAI, MiMo.
// Credit: one CreditLedger Durable Object per billed account (repository owner), $5 starting credit,
// runs pause at $0. Models: CODE_REVIEW_MODEL / SECURITY_REVIEW_MODEL (provider/model; price from the
// provider registry x 1.3).
// Secrets (both optional): AI_GATEWAY_TOKEN, the gateway's token when it is authenticated;
// MANAGED_ADMIN_TOKEN, bearer for POST /admin/accounts/<account>/credit (unset: nobody may grant).
// Deployed before the front Worker, which binds it as MANAGED.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "compatibility_date": "2026-10-07",
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RepoAgents",
        "name": "REPOS"
      },
      {
        "class_name": "CreditLedger",
        "name": "LEDGER"
      }
    ]
  },
  "main": "managed/index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RepoAgents",
        "CreditLedger"
      ],
      "tag": "v1"
    }
  ],
  "name": "yonedarepo-prod-agents-managed",
  "observability": {
    "enabled": true
  },
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "yonedarepo-prod-managed-dead-letter",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "queue": "yonedarepo-prod-managed-runs"
      }
    ],
    "producers": [
      {
        "binding": "RUNS",
        "queue": "yonedarepo-prod-managed-runs"
      }
    ]
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "managed.yonedarepo.com"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "CLAUDE_KEY",
      "secret_name": "Claude",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "ZAI_KEY",
      "secret_name": "ZAI",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "MIMO_KEY",
      "secret_name": "MiMo",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    }
  ],
  "services": [
    {
      "binding": "PLATFORM",
      "service": "yonedarepo-prod-platform"
    }
  ],
  "vars": {
    "AI_GATEWAY_PROVIDERS": "claude=anthropic,zai=custom-zai,mimo=custom-mimo",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/f011d0ee02b23cad26b4b38151b204ad/yonedarepo-prod-managed-agents",
    "CODE_REVIEW_MODEL": "zai/glm-5.3-flash",
    "PUBLIC_URL": "https://managed.yonedarepo.com",
    "SECURITY_REVIEW_MODEL": "claude/claude-sonnet-5-5"
  },
  "workers_dev": false,
  "workflows": [
    {
      "binding": "REVIEWS",
      "class_name": "ManagedReviewWorkflow",
      "name": "yonedarepo-prod-managed-reviews"
    }
  ]
}
