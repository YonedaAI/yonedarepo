        "max_batch_timeout": 1,
        "max_concurrency": 20,
        "max_retries": 3,
        "queue": "yonedarepo-dev-platform-jobs-weur"
      },
      {
        "dead_letter_queue": "yonedarepo-dev-platform-dead-letter-weur",
        "max_batch_size": 1,
        "max_concurrency": 4,
        "max_retries": 3,
        "queue": "yonedarepo-dev-platform-checks-weur"
      }
    ],
    "producers": [
      {
        "binding": "PLATFORM_QUEUE",
        "queue": "yonedarepo-dev-platform-jobs-weur"
      },
      {
        "binding": "PLATFORM_CHECKS",
        "queue": "yonedarepo-dev-platform-checks-weur"
      }
    ]
  },
  "r2_buckets": [
