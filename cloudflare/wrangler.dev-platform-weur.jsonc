{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "analytics_engine_datasets": [
    {
      "binding": "SITE_EVENTS",
      "dataset": "yonedarepo_dev_site_events"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "CheckContainer",
      "constraints": {
        "jurisdiction": "eu",
        "regions": [
          "WEUR"
        ]
      },
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "ImportContainer",
      "constraints": {
        "jurisdiction": "eu",
        "regions": [
          "WEUR"
        ]
      },
      "image": "./containers/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-3",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    },
    {
      "class_name": "PackBuilder",
      "constraints": {
        "jurisdiction": "eu",
        "regions": [
          "WEUR"
        ]
      },
      "image": "./pack-builder/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 4,
      "rollout_step_percentage": [
        100
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_id": "2c8c288e-8975-4b8f-955a-7e7e916fee7d",
      "database_name": "yonedarepo-dev-platform-index-weur",
      "migrations_dir": "migrations"
    },
    {
      "binding": "INDEX_ENAM",
      "database_id": "ec419fb5-308e-4c52-8252-6d321302d771",
      "database_name": "yonedarepo-dev-platform-index"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "WorkspaceAuthority",
        "name": "WORKSPACES",
        "script_name": "yonedarepo-dev-platform"
      },
      {
        "class_name": "SourceRepository",
        "name": "SOURCE_REPOS"
      },
      {
        "class_name": "CheckContainer",
        "name": "CHECK_RUNNERS"
      },
      {
        "class_name": "ImportContainer",
        "name": "IMPORT_RUNNERS"
      },
