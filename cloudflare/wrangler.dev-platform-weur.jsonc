        "class_name": "PackBuilder",
        "name": "PACK_BUILDERS"
      },
      {
        "class_name": "RepositoryReadCopy",
        "name": "READ_COPIES",
        "script_name": "yonedarepo-dev-platform"
      }
    ]
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 50000
  },
  "main": "worker/platform-index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "SourceRepository",
        "CheckContainer",
        "CommitShard",
        "LandCombiner",
        "PackBuilder",
        "ImportContainer"
      ],
      "tag": "v1"
    }
  ],
  "name": "yonedarepo-dev-platform-weur",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.01
    }
  },
  "placement": {
    "mode": "targeted",
    "region": "aws:eu-central-1"
  },
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "yonedarepo-dev-platform-dead-letter-weur",
