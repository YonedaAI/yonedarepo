// Generated from infra/envs/prod.json by `cargo xtask infra up`; edit the spec, not this file.
// Production front Worker (name kept from the agent layer, removed 2026-10-27): it serves the
// browser app on yonedarepo.com and www, account sign-in (/api/auth/*) and the owner session,
// and proxies /api/v1 to the production platform through the PLATFORM service binding on the
// same origin. Accounts live in the platform's WorkspaceAuthority (WORKSPACES script binding).
// It has no stores, containers or queues of its own; a new account's welcome email is asked of the platform over PLATFORM. Secrets, set from stdin:
// OWNER_TOKEN  production owner credential (~/.config/yonedarepo/prod.env)
// The exact www route keeps www on this Worker; the apex is a Custom Domain.
// v4 deletes the agent layer's Durable Object classes (RepositoryAuthority, LiveRoom,
// AgentSandbox) and their data; the agent-run code is on the agent-run-workspaces branch.
// Sign-in with GitHub and Google (worker/oauth.ts): optional secrets GITHUB_OAUTH_CLIENT_ID /
// GITHUB_OAUTH_CLIENT_SECRET (a GitHub OAuth App) and GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
// (a Google OAuth web client). A provider whose two secrets are unset is off: hidden on the sign-in
// page, its /auth/<provider>/* routes answer 404. Callback URLs: https://yonedarepo.com/auth/github/callback
// and https://yonedarepo.com/auth/google/callback. Deploy uploads them when the secrets file has them.
// /api/managed is proxied to the managed agents Worker (MANAGED service binding, deployed first).
// /install.sh and /downloads/* (worker/downloads.ts): the CLI installer and releases and the public Claude Code marketplace, from the DOWNLOADS bucket that cargo xtask downloads stages and uploads.
// Site analytics (worker/site-events.ts): one cookieless SITE_EVENTS data point per public HTML page view and per sign-up,
// into the Analytics Engine dataset yonedarepo_prod_site_events (created on first write; infra plan/prune do not track it;
// underscores, not hyphens: the dataset is a table name in Analytics Engine SQL).
// No IP, cookie or visitor id; signed-in requests (session cookie), /api, /auth and assets are skipped.
// WEB_ANALYTICS_TOKEN: the Cloudflare Web Analytics site token; set, the front Worker adds the beacon to public pages; empty, none.
// SEO_INDEXING=on lets search engines index the site: robots.txt allows it, sitemap.xml lists it and HTML has no X-Robots-Tag (worker/seo-files.ts).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "analytics_engine_datasets": [
    {
      "binding": "SITE_EVENTS",
      "dataset": "yonedarepo_prod_site_events"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "WorkspaceAuthority",
        "name": "WORKSPACES",
        "script_name": "yonedarepo-prod-platform"
      }
    ]
  },
  "limits": {
    "subrequests": 50000
  },
  "main": "worker/front-index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RepositoryAuthority",
        "LiveRoom",
        "ExecutionContainer",
        "SourceWorkspaceAuthority"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "AgentSandbox"
      ],
      "tag": "v2"
    },
    {
      "deleted_classes": [
        "ExecutionContainer",
        "SourceWorkspaceAuthority"
      ],
      "tag": "v3"
    },
    {
      "deleted_classes": [
        "RepositoryAuthority",
        "LiveRoom",
        "AgentSandbox"
      ],
      "tag": "v4"
    }
  ],
  "name": "yonedarepo-prod-agents",
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "yonedarepo-prod-downloads"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "custom_domain": true,
      "pattern": "yonedarepo.com"
    },
    {
      "custom_domain": true,
      "pattern": "www.yonedarepo.com"
    },
    {
      "pattern": "https://www.yonedarepo.com/*",
      "zone_name": "yonedarepo.com"
    }
  ],
  "services": [
    {
      "binding": "PLATFORM",
      "service": "yonedarepo-prod-platform"
    },
    {
      "binding": "MANAGED",
      "service": "yonedarepo-prod-agents-managed"
    }
  ],
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://yonedarepo.com",
    "SEO_INDEXING": "on",
    "WEB_ANALYTICS_TOKEN": "fd30d727a0dc4d4c949dee535977d1b2"
  },
  "workers_dev": true
}
