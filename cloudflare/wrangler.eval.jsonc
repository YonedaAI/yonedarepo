// N9 eval Worker (agent-layer side): runs fixed evaluation arms with real models against
// the isolated platform-only Worker, reached only through its public API (service
// binding) with per-repository tokens. Model keys stay in the Secrets Store; EVAL_TOKEN is
// a Worker secret (`wrangler secret put EVAL_TOKEN`). The spend cap can only be lowered
// here: the code ceiling is HARD_CAP_MICROUSD in eval/ledger.ts.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yonedarepo-eval-dev",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "main": "eval/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "EVAL_SPEND_CAP_MICROUSD": "5000000"
  },
  "secrets_store_secrets": [
    {
      "binding": "MIMO_KEY",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3",
      "secret_name": "MiMo"
    },
    {
      "binding": "ZAI_KEY",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3",
      "secret_name": "ZAI"
    }
  ],
  "services": [
    {
      "binding": "PLATFORM",
      "service": "yonedarepo-platform-dev"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SPEND",
        "class_name": "SpendLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SpendLedger"
      ]
    }
  ]
}
