{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yonedarepo-apps-dev",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "main": "apps/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "apps.yonedarepo.com", "custom_domain": true },
    // The exact www platform route takes precedence; the dot excludes the apex.
    { "pattern": "https://*.yonedarepo.com/*", "zone_name": "yonedarepo.com" }
  ],
  "vars": {
    "APP_DOMAIN": "yonedarepo.com",
    "APP_ORIGIN": "https://apps.yonedarepo.com",
    "PLATFORM_ORIGIN": "https://yonedarepo.com"
  },
  "services": [{ "binding": "PLATFORM", "service": "yonedarepo-dev" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": { "bindings": [{ "name": "APP_RUNNERS", "class_name": "AppRunner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppRunner"] }],
  "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "yonedarepo-dev-objects" }],
  "limits": { "cpu_ms": 50 }
}
