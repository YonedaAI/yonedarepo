// Generated from infra/envs/dev.json by `cargo xtask infra up`; edit the spec, not this file.
// Dev superfan: the cheap-model watcher (cloudflare/superfan) of the dev platform Worker
// (yonedarepo-dev-platform), with its own ledger and a $1/day cap. It keeps the platform's tail
// events and, hourly, reads the GraphQL Analytics API. The Durable Object namespace, queue and
// CheckContainer ids it queries are looked up by name at run time (no ids in this config), so
// CF_ANALYTICS_TOKEN needs Account Analytics Read plus Workers Scripts Read, Queues Read and
// Containers Read (all read-only). Secrets, set from stdin (~/.config/yonedarepo/staging.env):
// CF_ANALYTICS_TOKEN  API token with the read permissions above
// SUPERFAN_READ_TOKEN bearer for GET /findings, GET /status, POST /run
// New findings mail ADMIN_NOTIFY_EMAIL through Resend (superfan/notify.ts, the Secrets Store secret Resend-Yoneda): at most
// 8 digests a UTC day. Dev's bursts fire rules on purpose, so expect digests after a burst.
// WATCH_WIDE=on is the wide watch: the front and managed Workers (both name this Worker in tail_consumers), crons,
// every Durable Object class, the land queue, every queue, reconcile mismatches and repository storage; urgent
// findings mail at once, outside the digest cap, at most 6 a UTC day per signal, and a quick pass every five minutes
// (*/5, the cron quick.ts names) checks only those, so a site that is down is told in minutes. The token needs no more
// permissions. docs/incidents.md has what each alert means. Off (prod until the owner says): the hourly digest alone.
// WATCH_FRONT_URL is the site as people reach it. DEADMAN_URL is the dead-man (role deadman), which this Worker watches back.
// Deployed first: the dev platform names this Worker in tail_consumers.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "f011d0ee02b23cad26b4b38151b204ad",
  "compatibility_date": "2026-10-07",
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SuperfanLedger",
        "name": "LEDGER"
      }
    ]
  },
  "main": "superfan/index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "SuperfanLedger"
      ],
      "tag": "v1"
    }
  ],
  "name": "yonedarepo-dev-superfan",
  "observability": {
    "enabled": true
  },
  "preview_urls": false,
  "secrets_store_secrets": [
    {
      "binding": "MIMO_KEY",
      "secret_name": "MiMo",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "ZAI_KEY",
      "secret_name": "ZAI",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    },
    {
      "binding": "RESEND_API_KEY",
      "secret_name": "Resend-Yoneda",
      "store_id": "3d9115d4fe864c54a792bcb790a763e3"
    }
  ],
  "triggers": {
    "crons": [
      "7 * * * *",
      "*/5 * * * *"
    ]
  },
  "vars": {
    "ADMIN_NOTIFY_EMAIL": "hello@yonedarepo.com",
    "CF_ACCOUNT_ID": "f011d0ee02b23cad26b4b38151b204ad",
    "DAILY_CAP_MICROUSD": "1000000",
    "DEADMAN_URL": "https://yonedarepo-dev-deadman.mlong-f01.workers.dev",
    "EMAIL_FROM": "YonedaRepo (dev) <hello@yonedarepo.com>",
    "MIMO_TOKEN_PLAN_REGION": "sgp",
    "SUPERFAN_MODEL": "mimo-v2.6-flash",
    "TELEMETRY_SOURCE": "cloudflare",
    "WATCH_FRONT_URL": "https://dev.yonedarepo.com",
    "WATCH_SCRIPT": "yonedarepo-dev-platform",
    "WATCH_URL": "https://yonedarepo-dev-platform.mlong-f01.workers.dev",
    "WATCH_WIDE": "on"
  },
  "workers_dev": true
}
