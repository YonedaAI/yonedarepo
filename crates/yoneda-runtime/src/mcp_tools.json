[
  {
    "name": "repo_context",
    "description": "Get this execution's frozen repository and shared research artifact IDs",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "artifact_get",
    "description": "Read a shared research artifact by its provided ID",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "artifact_publish",
    "description": "Publish context. Research MUST include metadata.assumptions as an array of explicit bounded assertions; each item has statement, metric (string), limit (integer) and path. Example: {\"assumptions\":[{\"statement\":\"Upstream p99 stays within 100 ms\",\"metric\":\"upstream_p99_ms\",\"limit\":100,\"path\":\"src/main.rs\"}]}. Assertions remain agent-authored, not verified facts.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "assumptions": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "metric": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "statement",
                  "metric",
                  "limit",
                  "path"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "required": [
        "label",
        "kind",
        "content",
        "metadata"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "execution_status",
    "description": "Read this execution's current context and status",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "execution_complete",
    "description": "Hint that agent work is finished; trusted capture and verification remain independent",
    "inputSchema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "context_publish",
    "description": "Contribute a typed assertion to the assigned intent. The platform supplies intent and author identity from this active attempt. Supersede earlier records instead of editing them.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "intent",
            "requirement",
            "constraint",
            "assumption",
            "finding",
            "alternative",
            "proposed_decision",
            "question"
          ]
        },
        "statement": {
          "type": "string",
          "maxLength": 8192
        },
        "purpose": {
          "type": "string",
          "maxLength": 2048
        },
        "intent_id": {
          "type": "string",
          "description": "Optional canonical intent ID returned by repo_context. Omit it to use this attempt's assigned intent; a different intent is forbidden."
        },
        "links": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "relation": {
                "type": "string",
                "enum": [
                  "supports",
                  "challenges",
                  "depends_on",
                  "supersedes",
                  "answers",
                  "motivates"
                ]
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "target"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "statement",
        "purpose"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "context_search",
    "description": "Search repository context and prior alternatives; returns a bounded page and next_cursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "context_get",
    "description": "Read a context or decision node by its exact ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delegate_agent",
    "description": "If the approved run allows delegation, schedule an isolated child approach from the same frozen source and context. Provider, model and identity are inherited. Reuse request_id when retrying the identical request. Children have independent capture/checks and cannot publish canonical source. Do not wait in a loop for children; finish your own work.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "request_id",
        "task",
        "strategy"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delegation_status",
    "description": "Read this execution's direct children, their captured candidates and typed context, current shared provider/model request and spend allowances, approved output/time limits, and the 144-request run maximum. This does not approve or merge their source.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  }
]
