[
  {
    "name": "repo_context",
    "description": "Get this execution's frozen repository and shared research artifact IDs",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "artifact_get",
    "description": "Read a shared research artifact by its provided ID",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "artifact_publish",
    "description": "Publish context. Research MUST include metadata.assumptions as an array of explicit bounded assertions; each item has statement, metric (string), limit (integer) and path. Example: {\"assumptions\":[{\"statement\":\"Upstream p99 stays within 100 ms\",\"metric\":\"upstream_p99_ms\",\"limit\":100,\"path\":\"src/main.rs\"}]}. Assertions remain agent-authored, not verified facts.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "assumptions": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "metric": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "statement",
                  "metric",
                  "limit",
                  "path"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "required": [
        "label",
        "kind",
        "content",
        "metadata"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "execution_status",
    "description": "Read this execution's current context and status",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "execution_complete",
    "description": "Hint that agent work is finished; trusted capture and verification remain independent",
    "inputSchema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "context_publish",
    "description": "Contribute a typed assertion to the assigned intent. Identity comes from this attempt. Supersede earlier records instead of editing them.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "intent",
            "requirement",
            "constraint",
            "assumption",
            "finding",
            "alternative",
            "proposed_decision",
            "question"
          ]
        },
        "statement": {
          "type": "string",
          "maxLength": 8192
        },
        "purpose": {
          "type": "string",
          "maxLength": 2048
        },
        "intent_id": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "relation": {
                "type": "string",
                "enum": [
                  "supports",
                  "challenges",
                  "depends_on",
                  "supersedes",
                  "answers",
                  "motivates"
                ]
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "target"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "statement",
        "purpose",
        "intent_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "context_search",
    "description": "Search repository context and prior alternatives; returns a bounded page and next_cursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "context_get",
    "description": "Read a context or decision node by its exact ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
]
