// Bench client only (no bindings to platform state); see worker.js. Deploy with
//   npx wrangler deploy -c tools/fanout-bench/wrangler.jsonc
// and set its BENCH_KEY secret (stdin) to the key the driver sends.
{
  "name": "yonedarepo-bench-client",
  "main": "worker.js",
  "compatibility_date": "2026-10-07",
  // Reach the platform's workers.dev URL over the public internet, like any client.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  // Webhook receiver boxes (worker.js, POST /hooks/<box>), one object per box.
  "durable_objects": { "bindings": [{ "name": "HOOK_BOXES", "class_name": "HookBox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HookBox"] }]
}
