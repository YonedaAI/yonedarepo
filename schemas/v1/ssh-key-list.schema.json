{
  "$defs": {
    "SshKey": {
      "additionalProperties": false,
      "description": "An SSH public key on the account.",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "last_used_at": {
          "description": "Last Git over SSH use (Unix milliseconds), or null.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "title",
        "last_used_at"
      ],
      "type": "object"
    },
    "SshKeyList": {
      "additionalProperties": false,
      "description": "`ssh-key list`.",
      "properties": {
        "keys": {
          "items": {
            "$ref": "#/$defs/SshKey"
          },
          "type": "array"
        }
      },
      "required": [
        "keys"
      ],
      "title": "SshKeyList",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `yoneda --json` document of `ssh-key-list`.",
  "properties": {
    "data": {
      "$ref": "#/$defs/SshKeyList"
    },
    "schema": {
      "const": "yoneda.cli.ssh-key-list.v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "data"
  ],
  "title": "yoneda.cli.ssh-key-list.v1",
  "type": "object"
}
