{
  "$defs": {
    "CloneMethod": {
      "description": "How `clone` brought the repository in.",
      "oneOf": [
        {
          "const": "git_clone",
          "description": "An offline checkout by `git clone` with a short-lived read token.",
          "type": "string"
        },
        {
          "const": "api_snapshot",
          "description": "An offline checkout from a snapshot of the branch through the API.",
          "type": "string"
        },
        {
          "const": "lazy",
          "description": "A lazy `yoneda::` clone: commits and trees; file contents when Git needs them.",
          "type": "string"
        },
        {
          "const": "full",
          "description": "A `yoneda::` clone holding every object (`--full`).",
          "type": "string"
        },
        {
          "const": "sparse",
          "description": "A lazy `yoneda::` clone checked out only under `scope` (`--sparse`).",
          "type": "string"
        }
      ]
    },
    "Cloned": {
      "additionalProperties": false,
      "description": "`clone`.",
      "properties": {
        "dir": {
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/CloneMethod"
        },
        "repo": {
          "type": "string"
        },
        "scope": {
          "description": "The directories a sparse clone checks out (with the files at its top).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "description": "The log version of main the clone was made at (an offline checkout is pinned to it;\n0 for a repository without main).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "repo",
        "dir",
        "version",
        "method"
      ],
      "title": "Cloned",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `yoneda --json` document of `clone`.",
  "properties": {
    "data": {
      "$ref": "#/$defs/Cloned"
    },
    "schema": {
      "const": "yoneda.cli.clone.v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "data"
  ],
  "title": "yoneda.cli.clone.v1",
  "type": "object"
}
