{
  "$defs": {
    "Grep": {
      "additionalProperties": false,
      "description": "`grep`.",
      "properties": {
        "results": {
          "items": {
            "$ref": "#/$defs/GrepFile"
          },
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "title": "Grep",
      "type": "object"
    },
    "GrepFile": {
      "additionalProperties": false,
      "description": "A file with matches.",
      "properties": {
        "hits": {
          "default": null,
          "description": "Matches in the file, of which at most 20 lines are listed.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lines": {
          "description": "The matching lines (empty: the path itself matched).",
          "items": {
            "$ref": "#/$defs/GrepLine"
          },
          "type": "array"
        },
        "match": {
          "default": null,
          "description": "Why it ranks where it does: `word` (a whole-word match), `path` (the path matched),\nor `substring` (only inside words). Files are listed in that order, then by hits.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "match",
        "hits",
        "lines"
      ],
      "type": "object"
    },
    "GrepLine": {
      "additionalProperties": false,
      "description": "A matching line.",
      "properties": {
        "line": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ranges": {
          "default": [],
          "description": "Where the query matched in `text`: `[start, end)` in UTF-16 code units.",
          "items": {
            "items": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "line",
        "text",
        "ranges"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `yoneda --json` document of `grep`.",
  "properties": {
    "data": {
      "$ref": "#/$defs/Grep"
    },
    "schema": {
      "const": "yoneda.cli.grep.v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "data"
  ],
  "title": "yoneda.cli.grep.v1",
  "type": "object"
}
