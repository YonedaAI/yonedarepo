{
  "$defs": {
    "ChangeHit": {
      "description": "A change request whose title or description matched.",
      "properties": {
        "author": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "matched": {
          "description": "Where the words appeared: title, body.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "number": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "title",
        "status",
        "branch",
        "base",
        "author",
        "updated_at",
        "matched"
      ],
      "type": "object"
    },
    "CommitHit": {
      "description": "A commit whose message, recorder, touched paths or id matched.",
      "properties": {
        "commit": {
          "type": "string"
        },
        "matched": {
          "description": "Where the words appeared: id, subject, message, author, paths.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "description": "Paths it touched, the matching ones first (at most 5).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "principal": {
          "description": "Who recorded (pushed) it.",
          "type": "string"
        },
        "recorded_at": {
          "format": "int64",
          "type": "integer"
        },
        "subject": {
          "description": "The message's first line.",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "subject",
        "principal",
        "recorded_at",
        "matched",
        "paths"
      ],
      "type": "object"
    },
    "GrepFile": {
      "additionalProperties": false,
      "description": "A file with matches.",
      "properties": {
        "hits": {
          "default": null,
          "description": "Matches in the file, of which at most 20 lines are listed.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lines": {
          "description": "The matching lines (empty: the path itself matched).",
          "items": {
            "$ref": "#/$defs/GrepLine"
          },
          "type": "array"
        },
        "match": {
          "default": null,
          "description": "Why it ranks where it does: `word` (a whole-word match), `path` (the path matched),\nor `substring` (only inside words). Files are listed in that order, then by hits.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "match",
        "hits",
        "lines"
      ],
      "type": "object"
    },
    "GrepLine": {
      "additionalProperties": false,
      "description": "A matching line.",
      "properties": {
        "line": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ranges": {
          "default": [],
          "description": "Where the query matched in `text`: `[start, end)` in UTF-16 code units.",
          "items": {
            "items": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "line",
        "text",
        "ranges"
      ],
      "type": "object"
    },
    "Search": {
      "additionalProperties": false,
      "description": "`search`: one query across code, memories, commits, sessions and changes. A group not\nasked for (or, for a path-restricted token, memories, sessions and changes) is null.",
      "properties": {
        "changes": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchGroup3"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "description": "Files whose content or path matched (empty when code was not asked for).",
          "items": {
            "$ref": "#/$defs/GrepFile"
          },
          "type": "array"
        },
        "commits": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchGroup"
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "memories": {
          "description": "The platform's matching memories, unchanged.",
          "items": true,
          "type": [
            "array",
            "null"
          ]
        },
        "query": {
          "type": "string"
        },
        "sessions": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchGroup2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "query",
        "groups",
        "code",
        "memories",
        "commits",
        "sessions",
        "changes"
      ],
      "title": "Search",
      "type": "object"
    },
    "SearchGroup": {
      "description": "A group of records the search found: every match counted (`capped` once the platform\nstopped counting), the best listed.",
      "properties": {
        "capped": {
          "type": "boolean"
        },
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/CommitHit"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "capped",
        "results"
      ],
      "type": "object"
    },
    "SearchGroup2": {
      "description": "A group of records the search found: every match counted (`capped` once the platform\nstopped counting), the best listed.",
      "properties": {
        "capped": {
          "type": "boolean"
        },
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/SessionHit"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "capped",
        "results"
      ],
      "type": "object"
    },
    "SearchGroup3": {
      "description": "A group of records the search found: every match counted (`capped` once the platform\nstopped counting), the best listed.",
      "properties": {
        "capped": {
          "type": "boolean"
        },
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ChangeHit"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "capped",
        "results"
      ],
      "type": "object"
    },
    "SessionHit": {
      "description": "A session record whose summary or declared reads matched.",
      "properties": {
        "at": {
          "format": "int64",
          "type": "integer"
        },
        "cli": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "matched": {
          "description": "Where the words appeared: summary, reads.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "reads": {
          "description": "The commit's declared reads, the matching ones first (at most 5).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "commit",
        "cli",
        "model",
        "session_id",
        "summary",
        "at",
        "matched",
        "reads"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `yoneda --json` document of `search`.",
  "properties": {
    "data": {
      "$ref": "#/$defs/Search"
    },
    "schema": {
      "const": "yoneda.cli.search.v1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "data"
  ],
  "title": "yoneda.cli.search.v1",
  "type": "object"
}
