{
  "name": "yonedarepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo xtask dev",
    "build": "cargo xtask build",
    "check": "tsc --project cloudflare/tsconfig.json --noEmit && biome check cloudflare/worker cloudflare/sites frontend/src shared",
    "format": "biome check --write cloudflare/worker cloudflare/sites frontend/src shared",
    "test": "vitest run --config tests/workers/vitest.config.ts",
    "test:runtime": "node --test tests/runtime/*.test.mjs",
    "deploy": "cargo xtask deploy",
    "test:frontend": "vitest run --config tests/frontend/vitest.config.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261008.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
