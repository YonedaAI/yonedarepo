{
  "name": "yonedarepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo xtask dev",
    "build": "cargo xtask build",
    "check": "tsc --project cloudflare/tsconfig.json --noEmit && biome check cloudflare/worker cloudflare/superfan cloudflare/managed cloudflare/eval frontend/src shared",
    "format": "biome check --write cloudflare/worker cloudflare/superfan cloudflare/managed cloudflare/eval frontend/src shared",
    "test": "vitest run --config tests/workers/vitest.config.ts",
    "test:runtime": "node --test tests/runtime/*.test.mjs",
    "test:platform": "vitest run --config tests/platform/vitest.config.ts",
    "test:superfan": "vitest run --config tests/superfan/vitest.config.ts",
    "test:managed": "vitest run --config tests/managed/vitest.config.ts",
    "deploy": "cargo xtask deploy",
    "test:frontend": "vitest run --config tests/frontend/vitest.config.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  }
}
