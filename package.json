{
  "name": "yonedarepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm --dir web build && (cd crates/yoneda-worker && worker-build --release)",
    "check": "tsc --noEmit && biome check worker sites web/src",
    "format": "biome check --write worker sites web/src",
    "test": "vitest run",
    "test:runtime": "node --test tests/runtime/*.test.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261008.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.147.0"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
