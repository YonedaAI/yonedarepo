      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "git_log",
    "description": "First-parent history of a branch, newest first, with landing versions. With path, only commits that changed that path (or anything under a dir/ prefix).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "description": "Read as of this transaction-log version (time travel)"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "git_txlog",
    "description": "The hash-chained transaction log: every ref move with paths, read set and actor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "after": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
