  {
    "name": "git_get_objects",
    "description": "Fetch immutable Git objects by id and kind (tree entries, commit headers, blob bytes as base64), in order, up to a response budget. Resume with after=next. Start from a commit's tree and request only the subtrees and blobs you need (sparse by construction). Path-restricted tokens must pass commit and each object's path inside their grant.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "tree",
                  "blob",
                  "commit"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "after": {
          "type": "integer",
          "minimum": 0
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "objects"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_grep",
    "description": "Search file contents and paths at a commit, branch or past version (case-insensitive with ignore_case). Uses a trigram index partitioned by top-level directory and reused across commits; results list matching lines per file.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "description": "Only paths starting with this prefix"
        },
        "ignore_case": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_blame",
    "description": "Line-by-line attribution of a file on a branch: the commit that last changed each line, from the file's first-parent history.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "symbol_list",
    "description": "Symbols (functions, types, methods, modules) in a Rust, TypeScript or JavaScript file at a commit, branch or past version, each with a handle for symbol_edit. A parse failure is reported, never hidden.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "symbol_get",
    "description": "The source text of one symbol (by qualified path like Type::method, or name) with its handle. Read only what you need instead of whole files.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "symbol": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "symbol"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_diff",
    "description": "Files changed from base (default: head's first parent) to head, optionally with unified patches. merge_base compares against the common ancestor, like base...head.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "head": {
          "type": "string",
          "description": "A 40-hex commit id or a branch name (default main)"
        },
        "base": {
          "type": "string",
          "description": "A 40-hex commit id or a branch name (default main)"
        },
        "merge_base": {
          "type": "boolean"
        },
        "patch": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "description": "Only paths under this prefix"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "description": "Read as of this transaction-log version (time travel)"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "git_commit",
    "description": "Create a commit on the server from file changes against a branch head (or an explicit parent). Nothing is landed: the commit is recorded and must pass checks and review before git_land moves a branch. Declare read_set (paths, dir/ prefixes, or path#symbol entries such as src/lib.rs#Policy::backoff for the symbols you relied on) so concurrent work is checked for independence; the platform derives which symbols your change wrote.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Repository-relative path"
              },
              "content_b64": {
                "type": "string",
                "description": "New file content, base64"
              },
              "executable": {
                "type": "boolean"
              },
              "delete": {
                "type": "boolean"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        },
        "read_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "changes",
        "message",
        "author"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "symbol_edit",
    "description": "Replace one symbol's source on the head of a branch, creating (not landing) a commit. The handle must still match the symbol in the current file; a stale handle (the symbol changed or vanished) is rejected. The edited file must still parse.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string"
            },
            "symbol_path": {
              "type": "string"
            },
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "digest": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "symbol_path",
            "digest"
          ],
          "additionalProperties": false
        },
        "replacement": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "handle",
        "replacement"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_codemod",
    "description": "Literal find/replace across a branch (optionally under a path prefix), computed partition by partition and reduced into one commit (not landed).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "find": {
          "type": "string",
          "minLength": 2
        },
        "replace": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "find",
        "replace"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_plan",
    "description": "Plan proposed work items at one revision of a branch (nothing runs). Items whose symbols share a reference cycle that one of them writes are joined into one item; the rest are staged so items in one stage are independent (neither writes what the other reads or writes) and an item that reads what another writes comes after it. Reads are extended with the symbols their symbols reference (closure_depth). Items with a base_version report stale reads since then. Symbol entries on unparsed files are planned at path level.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "description": "Branch to plan against (default main)"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "description": "Log version to plan at (default now)"
        },
        "closure_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Reference steps added to reads (default 1)"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "base_version": {
                "type": "integer",
                "minimum": 0
              },
              "read_set": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "A path, a dir/ prefix, or path#symbol_path"
                }
              },
              "write_set": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "A path, a dir/ prefix, or path#symbol_path"
                }
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_check",
    "description": "Record a check result for an exact commit (requires the check scope).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidence": {
          "type": "object"
        }
      },
      "required": [
        "commit",
        "name",
        "status"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_check_run",
    "description": "Ask the platform to execute the policy's check runners on an exact commit (all runners, or one by name). Runs also start automatically when a commit is recorded; results appear in git_show.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "commit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_bisect",
    "description": "Find the first commit on a branch that breaks a policy check: start with good, bad and check (a policy runner name); the platform runs the check on midpoints and narrows the range as results arrive. Pass id to read progress.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "good": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bad": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "check": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "git_pin",
    "description": "Pin (or unpin) a commit so vacuum never releases its objects, for example while a long job reads it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reason": {
          "type": "string"
        },
        "unpin": {
          "type": "boolean"
        }
      },
      "required": [
        "commit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_review",
    "description": "Approve or reject a commit (requires the review scope; authors cannot review their own commits; rejection needs a reason).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "commit",
        "decision"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_merge",
    "description": "Create (not land) a merge commit of source (a branch or commit id) into branch `into` (default main), using a three-way merge on the server. Returns up_to_date or fast_forward when no merge commit is needed. Conflicts return CONFLICT with diff3-marked text per path to resolve in a follow-up commit.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "into": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_revert",
    "description": "Create (not land) a commit on the server that undoes a commit's changes relative to its first parent, on top of a branch head. Fails with CONFLICT when the branch changed those paths since; reconcile with a three-way merge instead.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "type": "string",
          "description": "Branch whose head becomes the parent (default main)"
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        },
        "read_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "commit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_cherry_pick",
    "description": "Create (not land) a commit on the server that re-applies a commit's changes on top of a branch head. Fails with CONFLICT when the branch's versions of those paths differ from the commit's parent.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "type": "string",
          "description": "Branch whose head becomes the parent (default main)"
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        },
        "read_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "commit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "git_land",
    "description": "Move a branch to a commit that passed its required checks and approvals (requires the land scope). If the branch moved meanwhile, the platform merges on the server: independent or cleanly mergeable work lands as a platform merge commit (post-land checks run on it); a stale read or textual conflict returns CONFLICT with details.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "ref",
        "commit"
      ],
      "additionalProperties": false
    }
  }
]
