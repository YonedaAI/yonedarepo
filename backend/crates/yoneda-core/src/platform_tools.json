  {
    "name": "git_commit",
    "description": "Create a commit on the server from file changes against a branch head (or an explicit parent). Nothing is landed: the commit is recorded and must pass checks and review before git_land moves a branch. Declare read_set (paths, dir/ prefixes, or path#symbol entries such as src/lib.rs#Policy::backoff for the symbols you relied on) so concurrent work is checked for independence; the platform derives which symbols your change wrote.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_version": {
          "type": "integer",
          "minimum": 0
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Repository-relative path"
              },
              "content_b64": {
                "type": "string",
                "description": "New file content, base64"
              },
              "executable": {
                "type": "boolean"
              },
              "delete": {
                "type": "boolean"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "message": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false
        },
        "read_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "changes",
        "message",
        "author"
      ],
      "additionalProperties": false
    }
  },
