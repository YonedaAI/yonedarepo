  {
    "name": "git_cat_file",
    "description": "Read one file at a commit, branch or past version. UTF-8 text is returned as text, other bytes as base64.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Repository-relative path"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
