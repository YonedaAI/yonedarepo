[
  {
    "name": "git_status",
    "description": "Repository head refs, current log version and landing policy.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "git_refs",
