          "type": "integer",
          "minimum": 0,
          "description": "Read as of this transaction-log version (time travel)"
        },
        "min_version": {
          "type": "integer",
          "minimum": 0,
          "description": "Read main at this transaction-log version or later (read-your-writes after git_land)"
        }
