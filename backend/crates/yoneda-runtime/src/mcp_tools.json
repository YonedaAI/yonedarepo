[
  {
    "name": "repo_context",
    "description": "Get this execution's frozen repository and shared research artifact IDs",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "artifact_get",
    "description": "Read a shared research artifact by its provided ID",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "artifact_publish",
    "description": "Publish context. Research MUST include metadata.assumptions as an array of explicit bounded assertions; each item has statement, metric (string), limit (integer) and path. Example: {\"assumptions\":[{\"statement\":\"Upstream p99 stays within 100 ms\",\"metric\":\"upstream_p99_ms\",\"limit\":100,\"path\":\"src/main.rs\"}]}. Assertions remain agent-authored, not verified facts.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "assumptions": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "metric": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "statement",
                  "metric",
                  "limit",
                  "path"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "required": [
        "label",
        "kind",
        "content",
        "metadata"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "execution_status",
    "description": "Read this execution's current context and status",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "execution_complete",
    "description": "Hint that agent work is finished; trusted capture and verification remain independent",
    "inputSchema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "context_publish",
    "description": "Contribute a typed assertion to the assigned intent. The platform supplies intent and author identity from this active attempt. Supersede earlier records instead of editing them.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "intent",
            "requirement",
            "constraint",
            "assumption",
            "finding",
            "alternative",
            "proposed_decision",
            "question"
          ]
        },
        "statement": {
          "type": "string",
          "maxLength": 8192
        },
        "purpose": {
          "type": "string",
          "maxLength": 2048
        },
        "intent_id": {
          "type": "string",
          "description": "Optional canonical intent ID returned by repo_context. Omit it to use this attempt's assigned intent; a different intent is forbidden."
        },
        "links": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "relation": {
                "type": "string",
                "enum": [
                  "supports",
                  "challenges",
                  "depends_on",
                  "supersedes",
                  "answers",
                  "motivates"
                ]
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "target"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "statement",
        "purpose"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "context_search",
    "description": "Search repository context and prior alternatives; returns a bounded page and next_cursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string"
        },
        "file_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 513
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lineage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "context_get",
    "description": "Read a context or decision node by its exact ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delegate_agent",
    "description": "If the approved run allows delegation, schedule an isolated child approach from the same frozen source and context. Provider, model and identity are inherited. Reuse request_id when retrying the identical request. Children have independent capture/checks and cannot publish canonical source. Do not wait in a loop for children; finish your own work.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "request_id",
        "task",
        "strategy"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delegation_status",
    "description": "Read this execution's direct children, their captured candidates and typed context, current shared provider/model request and spend allowances, approved output/time limits. This does not approve or merge their source.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "context_usage",
    "description": "Query structured recorded context delivery, retrieval, explicit citations, captured revisions and independent check results for this run. Counts describe evidence coverage, not whether an agent understood a record. This query does not record itself.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "team_context",
    "description": "Read your assigned team task, shared contract and exact captured dependency handoffs. Source is already assembled. Identity comes from the active attempt.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "task_handoff",
    "description": "Record an assertion describing your completed task and actual interface. Cite exact prior record IDs you used. This does not complete source capture or independently check your changes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "interface_contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "references": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "summary",
        "interface_contract",
        "references"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "integration_request",
    "description": "For the designated integrator only: read the immutable manifest of exact captured specialist revisions required in the final integrated candidate. This does not publish source.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "team_plan_propose",
    "description": "The assigned read-only planner proposes a complete complementary plan for the actual brief and frozen roster. Do not probe with placeholders. Rust validates scopes, references, graph and assignments. Before planning finishes, refine a draft by passing its current returned ID as expected_proposal. Each version is immutable; identical retries do not replace the active draft. At most eight versions per attempt. Activation waits for successful unchanged-source planner completion; this does not claim capture, checks or publication. For adaptive teams only, optional agents selects the actual 1\u20136 roster from the approved_model_pool returned by team_context; provide connection and role, preserve explicit requested rows and roles, and use plan indices for this proposed roster. Provider/model/routing/version and budgets are derived from the frozen pool by Rust, never model arguments.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer",
              "enum": [
                1
              ]
            },
            "contract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "integrator_agent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "integration_paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 513
              }
            },
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "instructions": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "agent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "depends_on": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "string"
                    }
                  },
                  "write_paths": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 513
                    }
                  }
                },
                "required": [
                  "id",
                  "title",
                  "instructions",
                  "agent",
                  "depends_on",
                  "write_paths"
                ]
              }
            }
          },
          "required": [
            "version",
            "contract",
            "integrator_agent",
            "integration_paths",
            "tasks"
          ]
        },
        "expected_proposal": {
          "type": "string",
          "description": "Current active draft ID returned by team_plan_propose or planner team_context. Required to replace a different draft before completion; omit on initial proposal."
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "description": "Adaptive only: actual task roster. Repeat on refined proposals. Exact saved connection identity is hydrated from the frozen pool.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "connection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "role": {
                "type": "string",
                "enum": [
                  "auto",
                  "builder",
                  "frontend",
                  "backend",
                  "design",
                  "testing",
                  "review"
                ]
              },
              "reasoning_effort": {
                "type": "string",
                "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "on", "off"],
                "description": "Retain the owner's explicit requested effort, supported by this exact frozen model. Omission inherits that request; Auto and additional rows must remain omitted. Never raise Auto to an explicit effort."
              }
            },
            "required": [
              "connection",
              "role"
            ]
          }
        }
      },
      "required": [
        "plan"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "peer_status",
    "description": "Inspect declared work, dependencies and current status of peers in this run. Candidate source is not returned. Use before choosing work or reporting a handoff.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "peer_message",
    "description": "Send a same-run collaboration assertion. Container lease assigns sender identity. Use a stable request_id; delivery confirms receipt, not correctness.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "enum": [
            "contract",
            "question",
            "finding",
            "blocker"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "context_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "request_id",
        "recipient",
        "kind",
        "body"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "peer_inbox",
    "description": "Read peer messages at planning, contract, edit, check and handoff checkpoints. Acknowledge delivered item IDs with ack_ids; next_cursor pages delivery only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "after": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "ack_ids": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "repair_request",
    "description": "Ask the read-only coordinator to inspect a blocker or amend source ownership/dependencies. This assertion does not authorize mutation or a new model.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "request_id",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "repair_team",
    "description": "Coordinator/integrator only: reopen selected tasks and all affected descendants under frozen autonomy. Read team_context for exact guards; provide every affected existing task revision including integrate. Upsert selected task_definitions within the approved project scopes. Two total repair rounds share existing budgets. Fresh capture and checks are required; canonical publication is owner-only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "expected_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0
        },
        "expected_plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expected_task_revisions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "maxProperties": 17
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "task_definitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "agent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "depends_on": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string"
                }
              },
              "write_paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 513
                }
              }
            },
            "required": [
              "id",
              "title",
              "instructions",
              "agent",
              "depends_on",
              "write_paths"
            ]
          }
        }
      },
      "required": [
        "request_id",
        "expected_commit",
        "expected_version",
        "expected_plan_revision",
        "expected_task_revisions",
        "run_id",
        "task_ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "refresh_candidate",
    "description": "Coordinator/integrator only: request trusted three-way refresh onto the current checked working branch or canonical target. Read conflict evidence after capture; even a clean merge needs new independent checks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "request_id",
        "candidate_id",
        "expected_commit",
        "expected_version"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "resolve_conflict",
    "description": "Coordinator/integrator only: schedule a scoped resolver on the trusted merge workspace using the frozen goal, context, approved model and shared budget. Provide target head, plan and affected task revisions from team_context; consumes one of two total repair rounds. Capture and independent checks are required before owner publication.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "expected_commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0
        },
        "expected_plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expected_task_revisions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "maxProperties": 17
        },
        "conflict_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "request_id",
        "expected_commit",
        "expected_version",
        "expected_plan_revision",
        "expected_task_revisions",
        "conflict_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "intent_question",
    "description": "Coordinator/integrator only: pause new source/check dispatch for an owner decision on product ambiguity. Never invent an answer or revise the approved goal, policy or spending limit.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "required": [
        "request_id",
        "question"
      ],
      "additionalProperties": false
    }
  }
]
