        "recursive": {
          "type": "boolean"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "expected_workspace_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
