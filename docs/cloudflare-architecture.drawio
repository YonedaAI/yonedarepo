<mxfile host="drawio">
  <diagram id="cf-arch" name="Cloudflare architecture">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1390" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;YonedaRepo on Cloudflare&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;owner &amp;amp; judges · yonedarepo.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="260" height="56" as="geometry" />
        </mxCell>

        <mxCell id="worker" value="&lt;b&gt;Main Worker&lt;/b&gt; · yonedarepo-dev (TypeScript + Rust)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=16;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1020" height="360" as="geometry" />
        </mxCell>

        <mxCell id="routes" value="&lt;b&gt;Routes&lt;/b&gt;   website · /api (owner &amp;amp; reviewer) · /git · /mcp      — sign-in limit 30/min · model keys in Secrets Store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="165" width="960" height="50" as="geometry" />
        </mxCell>

        <mxCell id="dogroup" value="&lt;b&gt;Durable Objects&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="70" y="235" width="960" height="145" as="geometry" />
        </mxCell>
        <mxCell id="do1" value="&lt;b&gt;★ RepositoryAuthority&lt;/b&gt;&lt;br&gt;source of truth&lt;br&gt;SQLite per repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="86" y="268" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="do2" value="&lt;b&gt;WorkspaceAuthority&lt;/b&gt;&lt;br&gt;spend &amp;amp; model connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="274" y="268" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="do3" value="&lt;b&gt;SourceWorkspace&lt;br&gt;Authority&lt;/b&gt;&lt;br&gt;files on demand&lt;br&gt;(experimental)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="462" y="268" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="do4" value="&lt;b&gt;LiveRoom&lt;/b&gt;&lt;br&gt;live updates&lt;br&gt;to the browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="650" y="268" width="176" height="96" as="geometry" />
        </mxCell>
        <mxCell id="do5" value="&lt;b&gt;AgentSandbox&lt;/b&gt;&lt;br&gt;one per agent attempt&lt;br&gt;stock coding CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="838" y="268" width="176" height="96" as="geometry" />
        </mxCell>

        <mxCell id="queues" value="&lt;b&gt;Queues&lt;/b&gt;    agent  →  capture  →  evaluate  →  publish      (3 retries, then dead-letter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="960" height="55" as="geometry" />
        </mxCell>

        <mxCell id="models" value="&lt;b&gt;Model providers&lt;/b&gt;&lt;br&gt;OpenAI · Anthropic&lt;br&gt;Z.ai · MiMo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1180" y="268" width="180" height="76" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;D1&lt;/b&gt;&lt;br&gt;project list &amp;amp; search" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;R2&lt;/b&gt;&lt;br&gt;bundles &amp;amp; site files" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="290" y="540" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="art" value="&lt;b&gt;Artifacts&lt;/b&gt;&lt;br&gt;Git repos&lt;br&gt;(project code)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="540" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cont" value="&lt;b&gt;Containers&lt;/b&gt; (up to 16)&lt;br&gt;agents write code here&lt;br&gt;no internet access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="540" width="270" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sites" value="&lt;b&gt;Sites Worker&lt;/b&gt; · yonedarepo-sites-dev&lt;br&gt;serves previews &amp;amp; published sites from R2&lt;br&gt;(used by the guided demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="apps" value="&lt;b&gt;Apps Worker&lt;/b&gt; · yonedarepo-apps-dev&lt;br&gt;runs dynamic apps in a sandbox&lt;br&gt;(deployed, not used by the demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="700" width="470" height="80" as="geometry" />
        </mxCell>

        <mxCell id="rule" value="&lt;b&gt;Rule:&lt;/b&gt; RepositoryAuthority is the only source of truth. D1 and LiveRoom are copies that can be rebuilt from it." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="1020" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="HTTPS + live updates" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=0.108;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="worker" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=0.353;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="worker" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=0.598;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="worker" target="art">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="starts" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=0.8;exitY=1;entryX=0.3;entryY=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="cont">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="every call goes&lt;br&gt;back through the Worker" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#82b366;exitX=0.85;exitY=0;entryX=0.968;entryY=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cont" target="worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="model calls" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=1;exitY=0.514;entryX=0;entryY=0.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="models">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="reads" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=0.766;exitY=0;entryX=0.5;entryY=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sites" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
