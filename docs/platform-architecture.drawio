<mxfile host="drawio">
  <diagram id="platform-arch" name="Source platform">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;YonedaRepo source platform&lt;/b&gt; · Cloudflare · 2026-10-20" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="clients" value="&lt;b&gt;Clients&lt;/b&gt;&lt;br&gt;Agents · Claude Code · Codex · CI · humans (browser)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="860" height="56" as="geometry" /></mxCell>
        <mxCell id="agents" value="&lt;b&gt;Agent layer&lt;/b&gt; (separate Worker + DOs)&lt;br&gt;runs · teams · guided · compare&lt;br&gt;token: read / write / check, never land" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="worker" value="&lt;b&gt;Platform Worker&lt;/b&gt; · us-east-1 · stateless Rust compute · auth · build commit / diff / merge" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2e6;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1320" height="56" as="geometry" /></mxCell>
        <mxCell id="shards" value="&lt;b&gt;Commit shards&lt;/b&gt;&lt;br&gt;16 DOs per repo&lt;br&gt;picked by commit id&lt;br&gt;unlanded work" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="batcher" value="&lt;b&gt;Landing batcher&lt;/b&gt;&lt;br&gt;per branch · 64–128 per batch&lt;br&gt;write-skew rule (ticket order)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="tiers" value="&lt;b&gt;Object tiers&lt;/b&gt;&lt;br&gt;1 edge cache (100%)&lt;br&gt;2 R2 (main store)&lt;br&gt;3 staged copy (DO)&lt;br&gt;4 Artifacts&lt;br&gt;+ warm-start seeds (99.2% warm checks)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="330" height="150" as="geometry" /></mxCell>
        <mxCell id="queues" value="&lt;b&gt;Queues&lt;/b&gt;&lt;br&gt;jobs · checks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1070" y="320" width="290" height="70" as="geometry" /></mxCell>
        <mxCell id="repodb" value="&lt;b&gt;Repo database&lt;/b&gt; (1 DO per repo)&lt;br&gt;txlog + txlog_paths&lt;br&gt;OCC: paths since base version&lt;br&gt;append changeset · CAS main&lt;br&gt;tokens · grants · protected refs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#1f4e9a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="500" width="460" height="120" as="geometry" /></mxCell>
        <mxCell id="background" value="&lt;b&gt;Background&lt;/b&gt; (never on the hot path)&lt;br&gt;Git view builder → Git trees / commits for main (deterministic ids) → R2 → Artifacts (main / release only · git clone · export)&lt;br&gt;Derived data → search · blame · history · symbols · review classes&lt;br&gt;Checks (CI) → Containers · exact commit · deadline · destroy() after&lt;br&gt;Analytics → Basin Pipeline → Iceberg (Basin Catalog) → Basin SQL&lt;br&gt;D1 index → repo discovery / catalog (rebuildable)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f8f8f8;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1320" height="170" as="geometry" /></mxCell>
        <mxCell id="watch" value="&lt;b&gt;Watch&lt;/b&gt; · superfan Worker · tail feed + hourly cheap-model check · $1/day cap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff9c4;strokeColor=#b59f00;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1320" height="40" as="geometry" /></mxCell>
        <mxCell id="notes" value="&lt;b&gt;Per repo&lt;/b&gt; (scales with repo count): 1 repo DB · 16 shards · 1 batcher per branch · 1 Artifacts repo&lt;br&gt;&lt;b&gt;Shared&lt;/b&gt; (fills up first): check containers (cap 8) · queues · D1 index · us-east-1 placement&lt;br&gt;&lt;b&gt;In progress (&quot;go 1–4&quot;)&lt;/b&gt;, so the repo DB handles landing batches only: (1) commit start reads a cached head, permissions re-checked at landing · (2) landing stores a pointer to the shard record, copy-in happens later · (3) status and reads from the cached head + changes since · (4) Git view: 1 commit per batch, one bulk write&lt;br&gt;Numbers are platform-dev benchmarks; 1–4 is not measured yet." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1320" height="130" as="geometry" /></mxCell>
        <mxCell id="e_clients" value="HTTP /api/v1 + MCP (scoped tokens)" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="clients" target="worker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_agents" value="public API only" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agents" target="worker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_commit" value="COMMIT" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="shards"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_land" value="LAND" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="batcher"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_read" value="READ" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="tiers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_async" value="ASYNC" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="queues"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_shard_db" value="log points at shard record (2)" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="shards" target="repodb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_batch_db" value="1 call per batch" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="batcher" target="repodb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db_bg" value="landed versions" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="repodb" target="background"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_q_bg" value="" style="endArrow=block;html=1;rounded=0;fontSize=12;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="queues" target="background"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
